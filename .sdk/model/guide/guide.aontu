  # messaging_conversation_message
  messaging_conversation_message: path: {
    "/api/v1/organizations/{organization_id}/verification/projects/{project_id}/messaging_conversations/{id}/messages": {
      rename: param: "id": "messaging_conversation_id"
      rename: param: "project_id": "project_id"
