  # page
  page: path: {
    "/api/v1/organizations/{organization_id}/verify/page": {
      op: load: method: GET
    }
  }

  # page_agent
  page_agent: path: {
    "/api/v1/organizations/{organization_id}/agents/page": {
      op: list: method: GET
    }
    "/api/v1/organizations/{organization_id}/agents/page/activity": {
      action: "activity": {}
      op: create: method: POST
      op: create: transform: res: "`body.agents`"
    }
    "/api/v1/organizations/{organization_id}/agents/page/roster": {
      action: "roster": {}
      op: load: method: GET
    }
  }

