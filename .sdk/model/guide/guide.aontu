# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"

# --- Scope and resources -------------------------------------------------
# Composal's definition is generated from its application's routes: 2,008
# operations. The SDK covers every one a customer can call (Richard,
# 2026-11-24: "every callable operation"): 1,747. Left out are only the 38
# operations Composal marks x-internal, the 194 it marks deprecated (among
# them the /clawder paths, which the agent docs replace with /spark), and the
# 29 that need a service credential rather than a personal access token.
#
# The heuristic names resources from response schemas. Here many routes share
# a schema or have none, so it put hundreds of routes in one entity
# (`organization`, `hosting`), where many could never be reached, and named
# agent resources after internal schema names. Below, every route is declared
# on the resource its path names: the last collection in the path, under its
# parent (`agent_thread`, `app_deployment`). A verb after a record's id is an
# action, selected with `$action` (`archive`, `cancel`). The record's own id is
# `id`, a parent's is `<parent>_id`, and the organization, which the definition
# calls `organization_id` on some routes and `org_slug` on others, is always
# `organization_id` (it takes the slug or the public id). Every path
# parameter is named explicitly, so no default rename of the heuristic's
# applies. Response transforms are the heuristic's own for each route.
#
# One nested block: written as one statement per route, about 500 or more
# top-level statements fail the model build as a false circular reference.
#
# Generated from one route table checked against the definition: every
# callable route declared once, and no two routes of one resource and op with
# the same parameters and action.
guide: entity: {

  # a2a_well_known
  a2a_well_known: path: {
    "/api/v1/control/a2a/{connection_id}/.well-known/agent-card.json": {
      action: "agent_card_json": {}
      rename: param: "connection_id": "a2a_id"
      op: load: method: GET
    }
  }

  # admin_org
  admin_org: path: {
    "/api/v1/admin/organizations": {
      op: list: method: GET
      op: create: method: POST
    }
    "/api/v1/admin/organizations/{org_slug}": {
      rename: param: "org_slug": "id"
      op: load: method: GET
    }
    "/api/v1/admin/organizations/{org_slug}/billing_agreement": {
      action: "billing_agreement": {}
      rename: param: "org_slug": "id"
      op: update: method: PUT
    }
    "/api/v1/admin/organizations/{org_slug}/billing_contact": {
      action: "billing_contact": {}
      rename: param: "org_slug": "id"
      op: patch: method: PATCH
    }
    "/api/v1/admin/organizations/{org_slug}/checkout_session": {
      action: "checkout_session": {}
      rename: param: "org_slug": "id"
      op: create: method: POST
    }
    "/api/v1/admin/organizations/{org_slug}/package": {
      action: "package": {}
      rename: param: "org_slug": "id"
      op: update: method: PUT
    }
  }

  # agent
  agent: path: {
    "/api/v1/agent/chat": {
      action: "chat": {}
      op: create: method: POST
    }
    "/api/v1/organizations/{organization_id}/agents": {
      op: list: method: GET
      op: list: transform: res: "`body.agents`"
      op: list: transform: page: next: "`body.pagination.next`"
      op: create: method: POST
      op: create: transform: res: "`body.agent`"
    }
    "/api/v1/organizations/{organization_id}/agents/{id}": {
      rename: param: "id": "id"
      op: remove: method: DELETE
      op: load: method: GET
      op: load: transform: res: "`body.agent`"
    }
    "/api/v1/organizations/{organization_id}/agents/{id}/avatar": {
      action: "avatar": {}
      rename: param: "id": "id"
      op: load: method: GET
    }
    "/api/v1/organizations/{organization_id}/agents/{id}/rename": {
      action: "rename": {}
      rename: param: "id": "id"
      op: patch: method: PATCH
      op: patch: transform: res: "`body.agent`"
    }
    "/api/v1/organizations/{organization_id}/agents/{id}/roster_position": {
      action: "roster_position": {}
      rename: param: "id": "id"
      op: patch: method: PATCH
    }
    "/api/v1/organizations/{organization_id}/agents/{id}/sharing": {
