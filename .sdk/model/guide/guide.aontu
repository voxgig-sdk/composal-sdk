    "/api/v1/hosting/locations": {
      op: list: method: GET
      op: list: transform: res: "`body.locations`"
    }
  }

  # me
  me: path: {
    "/api/v1/me": {
      op: load: method: GET
      op: patch: method: PATCH
    }
    "/api/v1/me/account_deletion": {
      action: "account_deletion": {}
      op: load: method: GET
      op: load: transform: res: "`body.request`"
      op: create: method: POST
    }
    "/api/v1/me/active_organization": {
      action: "active_organization": {}
      op: update: method: PUT
      op: update: transform: res: "`body.active_organization`"
    }
    "/api/v1/me/app_promotion": {
      action: "app_promotion": {}
      op: create: method: POST
    }
    "/api/v1/me/landing": {
      action: "landing": {}
      op: load: method: GET
    }
    "/api/v1/me/profile_image": {
      action: "profile_image": {}
      op: remove: method: DELETE
      op: update: method: PUT
    }
    "/api/v1/me/workspace_suggestion": {
      action: "workspace_suggestion": {}
      op: load: method: GET
    }
  }

  # me_email
  me_email: path: {
    "/api/v1/me/emails": {
      op: list: method: GET
      op: list: transform: res: "`body.emails`"
      op: create: method: POST
    }
    "/api/v1/me/emails/{id}": {
      rename: param: "id": "id"
      op: remove: method: DELETE
      op: patch: method: PATCH
      op: update: method: PUT
    }
    "/api/v1/me/emails/{id}/resend_verification": {
      action: "resend_verification": {}
      rename: param: "id": "id"
      op: create: method: POST
    }
  }

  # me_onboarding
  me_onboarding: path: {
    "/api/v1/me/onboarding/call": {
      action: "call": {}
      op: create: method: POST
    }
    "/api/v1/me/onboarding/claim": {
      action: "claim": {}
      op: create: method: POST
    }
    "/api/v1/me/onboarding/dismiss": {
      action: "dismiss": {}
      op: create: method: POST
    }
  }

  # media_file
  media_file: path: {
    "/api/v1/organizations/{organization_id}/browser_sessions/{browser_session_id}/media/{id}/files/{file_id}": {
      rename: param: "browser_session_id": "browser_session_id"
      rename: param: "file_id": "id"
      rename: param: "id": "media_id"
      op: load: method: GET
    }
  }

  # member
  member: path: {
    "/api/v1/organizations/{organization_id}/members": {
      op: list: method: GET
      op: list: transform: res: "`body.invitations`"
    }
    "/api/v1/organizations/{organization_id}/members/{id}": {
      rename: param: "id": "id"
      op: remove: method: DELETE
      op: patch: method: PATCH
      op: patch: transform: res: "`body.member`"
      op: update: method: PUT
      op: update: transform: res: "`body.member`"
    }
  }

  # memory
  memory: path: {
    "/api/v1/organizations/{organization_id}/verify/memories": {
      op: list: method: GET
      op: list: transform: res: "`body.memories`"
