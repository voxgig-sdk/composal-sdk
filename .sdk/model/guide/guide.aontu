  # merge_request
  merge_request: path: {
    "/api/v1/organizations/{organization_id}/verify/merge_requests": {
      op: create: method: POST
    }
    "/api/v1/organizations/{organization_id}/verify/merge_requests/preview": {
      action: "preview": {}
      op: create: method: POST
    }
    "/api/v1/organizations/{organization_id}/verify/merge_requests/{id}": {
