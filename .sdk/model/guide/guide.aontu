  metric_query: path: {
    "/api/v1/hosting/metrics/queries": {
      op: list: method: GET
    }
  }

  # network_connection
  network_connection: path: {
    "/api/v1/organizations/{organization_id}/verify/network_connections": {
      op: create: method: POST
