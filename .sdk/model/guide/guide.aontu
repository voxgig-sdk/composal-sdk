# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"

# --- Scope and resources -------------------------------------------------
# Composal's definition is generated from the application's routes: 2,008
# operations, including payment and telemetry callbacks, internal services and
# admin routes. The SDK covers the areas the API reference
# (composal.com/docs/api.md) lists: persistent agents and their marketplace,
# Verify (projects, scenarios, runs, findings, browser runners), hosting (apps,
# environments, services, deployments, domains, CDN, static sites), the
# container registry, and the current user, tokens, organizations, members and
# invitations. Within those areas it leaves out routes marked x-internal or
# deprecated (the /clawder paths, which the agent docs replace with /spark),
# and routes that need a credential other than the personal access token.
# 727 of the 2,008 operations are in scope.
#
# The heuristic names resources from response schemas. Here many routes share
# a schema or have none, so it put dozens of routes in one entity
# (`organization`, `hosting`), where 142 of them could never be reached, and
# named agent resources after internal schema names. Below, every in-scope
# route is declared on the resource its path names: the last collection in the
# path, under its parent (`agent_thread`, `app_deployment`). A verb after a
# record's id is an action, selected with `$action` (`archive`, `cancel`). The
# record's own id is `id`, a parent's is `<parent>_id`, and the organization,
# which the definition calls `organization_id` on some routes and `org_slug` on
# others, is always `organization_id` (it takes the slug or the public id).
# Response transforms are the heuristic's own for each route.
#
# Generated from one route table checked against the definition: every
# in-scope route declared once, and no two routes of one resource and op with
# the same parameters and action.
guide: entity: {

  # agent
  agent: path: {
    "/api/v1/organizations/{organization_id}/agents": {
      op: list: method: GET
      op: list: transform: res: "`body.agents`"
      op: list: transform: page: next: "`body.pagination.next`"
      op: create: method: POST
      op: create: transform: res: "`body.agent`"
    }
    "/api/v1/organizations/{organization_id}/agents/{id}": {
      rename: param: "id": "id"
      op: remove: method: DELETE
      op: load: method: GET
      op: load: transform: res: "`body.agent`"
    }
    "/api/v1/organizations/{organization_id}/agents/{id}/avatar": {
      action: "avatar": {}
      rename: param: "id": "id"
      op: load: method: GET
    }
