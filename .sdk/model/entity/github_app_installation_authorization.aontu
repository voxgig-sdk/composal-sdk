            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "github_app"
            }
            {
              lit: "installation_authorizations"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "code"
            "error"
            "state"
          ]
          co: {
            id: "POST /api/v1/github_app/installation_authorizations/complete"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/github_app/installation_authorizations/complete"
          q: {
            "$action": "complete"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "github_app"
            }
            {
              lit: "installation_authorizations"
            }
            {
              lit: "complete"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
