# Entity: github_app_installation_authorization

main: kit: entity: github_app_installation_authorization: {

  alias: field: {}

  fields: {
    installation_url: {
      fo: "uri"
      h: "Installation Url"
      n: "installation_url"
      r: true
      t: "`$STRING`"
    }
    organization_slug: {
      h: "Organization Slug"
      n: "organization_slug"
      r: true
      sh: "Vex organization slug whose installation will be linked."
      t: "`$STRING`"
    }
    return_target: {
      h: "Return Target"
      n: "return_target"
      r: true
      sh: "Server-validated Vex application target used after verification."
      t: "`$STRING`"
    }
  }

  name: "github_app_installation_authorization"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "organization_slug"
            "return_target"
          ]
          co: {
