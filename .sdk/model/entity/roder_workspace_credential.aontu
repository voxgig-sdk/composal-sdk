# Entity: roder_workspace_credential

main: kit: entity: roder_workspace_credential: {

  alias: field: {}

  fields: {
    api_token: {
      fo: "password"
      h: "Api Token"
      n: "api_token"
      r: true
      sh: "Short-lived personal access token for the spawning user."
      t: "`$STRING`"
    }
    author_email: {
      fo: "email"
      h: "Author Email"
      n: "author_email"
      r: true
      t: "`$STRING`"
    }
    author_name: {
      h: "Author Name"
      n: "author_name"
      r: true
      t: "`$STRING`"
    }
    clone_url: {
      fo: "uri"
      h: "Clone Url"
      n: "clone_url"
      r: true
      t: "`$STRING`"
    }
    default_branch: {
      h: "Default Branch"
      n: "default_branch"
      r: true
      t: "`$STRING`"
    }
    expires_at: {
      fo: "date-time"
      h: "Expires At"
      n: "expires_at"
      r: true
      t: "`$STRING`"
    }
    organization_id: {
      h: "Organization Id"
      n: "organization_id"
      r: true
      t: "`$STRING`"
    }
    repository_id: {
      h: "Repository Id"
      n: "repository_id"
      r: true
      t: "`$STRING`"
    }
    repository_slug: {
      h: "Repository Slug"
      n: "repository_slug"
      r: true
      t: "`$STRING`"
    }
    repository_spec: {
      h: "Repository Spec"
      n: "repository_spec"
      r: true
      sh: "The explicitly selected physical repository address."
      t: "`$STRING`"
    }
    required_lifetime_seconds: {
      h: "Required Lifetime Seconds"
      n: "required_lifetime_seconds"
      r: true
      sh: "Lifetime the pending clone or command must be able to complete within."
      t: "`$INTEGER`"
    }
    token: {
      fo: "password"
      h: "Token"
      n: "token"
      r: true
      sh: "Short-lived read/write repository credential."
      t: "`$STRING`"
    }
    username: {
      h: "Username"
      n: "username"
      r: true
      t: "`$STRING`"
    }
  }

  name: "roder_workspace_credential"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "required_lifetime_seconds"
          ]
          co: {
            id: "POST /api/v1/agent/roder/workspace_credentials"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/agent/roder/workspace_credentials"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "agent"
            }
            {
              lit: "roder"
            }
            {
              lit: "workspace_credentials"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
