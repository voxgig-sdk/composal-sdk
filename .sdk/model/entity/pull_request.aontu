# Entity: pull_request

main: kit: entity: pull_request: {

  alias: field: {}

  fields: {
    available_tests: {
      h: "Available Tests"
      n: "available_tests"
      r: true
      sh: "All active saved scenarios in the configured project, including scenarios outside the automatic selection."
      t: "`$ARRAY`"
    }
    branch: {
      h: "Branch"
      n: "branch"
      r: false
      sh: "Exact deployed source branch; refused if it differs from the canonical request branch."
      t: "`$STRING`"
    }
    cleanup_only: {
      h: "Cleanup Only"
      n: "cleanup_only"
      r: false
      sh: "Refresh canonical PR state and cancel closed-preview work without preparing a new verification request, including when its PR record is missing."
      t: "`$BOOLEAN`"
    }
    current_run: {
      h: "Current Run"
      n: "current_run"
      r: false
      sh: "Latest verification request if it matches the current head and base, independent of history pagination."
      t: "`$ANY`"
    }
    findings: {
      h: "Findings"
      n: "findings"
      r: true
      t: "`$ARRAY`"
    }
    head_sha: {
      h: "Head Sha"
      n: "head_sha"
      r: false
      sh: "If supplied, refuse to create a run unless this is the current PR head."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      syn: true
      t: "`$STRING`"
    }
    idempotency_key: {
      h: "Idempotency Key"
      n: "idempotency_key"
      r: true
      t: "`$STRING`"
    }
    imessage_number: {
      h: "Imessage Number"
      n: "imessage_number"
      r: false
      sh: "International destination of this exact deployed commit."
      t: "`$STRING`"
    }
    number: {
      h: "Number"
      n: "number"
      r: false
      t: "`$INTEGER`"
    }
    pagination: {
      h: "Pagination"
      n: "pagination"
      r: true
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 3
      }
    }
    permissions: {
      h: "Permissions"
      n: "permissions"
      r: true
      t: "`$OBJECT`"
    }
    preview_cleanup_ready: {
      h: "Preview Cleanup Ready"
      n: "preview_cleanup_ready"
      r: true
      sh: "The source is closed or merged and unfinished Scenario execution and Discovery have stopped."
      t: "`$BOOLEAN`"
    }
    preview_url: {
      fo: "uri"
      h: "Preview Url"
      n: "preview_url"
      r: false
      sh: "Most recently supplied preview URL for the current head commit, retained across verification attempts."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    project: {
      h: "Project"
      n: "project"
      r: false
      t: "`$ANY`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: false
      sh: "Composal project slug or public ID for PR preview environments."
      t: "`$STRING`"
    }
    pull_request: {
      h: "Pull Request"
      n: "pull_request"
      r: true
      t: "`$OBJECT`"
    }
    repository_id: {
      h: "Repository Id"
      n: "repository_id"
      r: false
      t: "`$STRING`"
    }
    runs: {
      h: "Runs"
      n: "runs"
      r: true
      t: "`$ARRAY`"
    }
  }

