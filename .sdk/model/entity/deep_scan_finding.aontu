      h: "Permissions"
      n: "permissions"
      r: true
      t: "`$OBJECT`"
    }
    priority: {
      h: "Priority"
      n: "priority"
      r: true
      sh: "The priority findings are narrowed to, or null when they are not narrowed."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    priority_counts: {
      h: "Priority Counts"
      n: "priority_counts"
      r: true
      t: "`$OBJECT`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: true
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    reproduction_of: {
      h: "Reproduction Of"
      n: "reproduction_of"
      r: true
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    reproductions: {
      h: "Reproductions"
      n: "reproductions"
      r: true
      sh: "Fresh-browser reruns of this scan's reported bugs."
      t: "`$ARRAY`"
    }
    reruns_available: {
      h: "Reruns Available"
      n: "reruns_available"
      r: true
      sh: "Whether findings can be rerun; a scan with locked findings waits for a paid plan."
      t: "`$BOOLEAN`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      t: "`$STRING`"
    }
    unlock: {
      h: "Unlock"
      n: "unlock"
      r: true
      sh: "Whether a paid plan would unlock some of this scan's findings, and whether this person may choose one."
      t: "`$OBJECT`"
    }
    web_url: {
      h: "Web Url"
      n: "web_url"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "deep_scan_finding"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
