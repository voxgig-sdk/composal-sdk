        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    free_findings_pending: {
      h: "Free Findings Pending"
      n: "free_findings_pending"
      r: true
      sh: "Whether a scan with locked findings has yet to choose which are free, so every row is locked for now."
