# Entity: deep_scan_finding

main: kit: entity: deep_scan_finding: {

  alias: field: {}

  fields: {
    finding_count: {
      h: "Finding Count"
      n: "finding_count"
      r: true
      sh: "Findings at every priority; findings lists only the listed priority."
      t: "`$INTEGER`"
    }
    finding_ids: {
      h: "Finding Ids"
      n: "finding_ids"
      r: true
      sh: "Original team order used by legacy hash links and rerun indices."
      t: "`$ARRAY`"
    }
    findings: {
      h: "Findings"
      n: "findings"
      r: true
      t: "`$ARRAY`"
    }
