      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    execution: {
      h: "Execution"
      n: "execution"
      r: false
      sh: "device_folder threads also report state and path; sandbox threads run on their own machine with the coding agent in harness."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    first_input: {
      h: "First Input"
      n: "first_input"
      r: false
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    first_input_key: {
      h: "First Input Key"
      n: "first_input_key"
      r: false
      sh: "Idempotency-Key that finds the first message through input_delivery."
      t: "`$STRING`"
    }
    first_input_requester_membership_id: {
      h: "First Input Requester Membership Id"
      n: "first_input_requester_membership_id"
      r: false
      sh: "Membership the first message was sent as, for input_delivery."
      t: "`$STRING`"
    }
    group: {
      h: "Group"
      n: "group"
      r: true
      sh: "Rails-owned list group, in precedence order: attention, active run, coordination custody, then done."
