            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "organizations"
            }
            {
              var: "organization_id"
            }
            {
              lit: "github_onboarding"
            }
            {
              lit: "imports"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.batch`"
          }
        }
      ]
    }
  }


