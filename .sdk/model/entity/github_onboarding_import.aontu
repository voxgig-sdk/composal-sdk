      n: "updated_at"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "github_onboarding_import"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "github_app_installation_id"
            "repositories"
          ]
          co: {
            id: "POST /api/v1/organizations/{organization_id}/github_onboarding/imports"
            source: "openapi3"
