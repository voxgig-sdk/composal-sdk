# Entity: repo

main: kit: entity: repo: {

  alias: field: {}

  fields: {
    can_retry_import: {
      h: "Can Retry Import"
      n: "can_retry_import"
      r: true
      sh: "True when a failed client import can be requeued for CLI resume."
      t: "`$BOOLEAN`"
    }
    can_retry_sync: {
      h: "Can Retry Sync"
      n: "can_retry_sync"
      r: true
      sh: "True when the latest sync run failed and can be retried."
