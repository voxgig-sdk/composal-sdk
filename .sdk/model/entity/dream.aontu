                or: "page"
                r: false
                style: "form"
                t: "`$INTEGER`"
              }
              {
                explode: true
                k: "query"
                n: "project_id"
                or: "project_id"
                r: true
                style: "form"
                t: "`$STRING`"
              }
              {
                ex: "changes"
                explode: true
