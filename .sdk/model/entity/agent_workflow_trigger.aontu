      h: "Next Due At"
      n: "next_due_at"
      r: true
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    pause_cause: {
      h: "Pause Cause"
      n: "pause_cause"
      r: true
      sh: "A person paused it, the file changed and nobody checked it, the saved steps can't run on it, or it is kept only so its subscription starts nothing"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    paused: {
      h: "Paused"
      n: "paused"
      r: true
      sh: "The workflow starts nothing until a person resumes or checks it"
      t: "`$BOOLEAN`"
    }
    read_at: {
      h: "Read At"
      n: "read_at"
      r: true
      sh: "The settings_changed_at you read; a change made since is refused"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    run_budget_usd: {
      h: "Run Budget Usd"
      n: "run_budget_usd"
      r: true
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    schedule: {
      h: "Schedule"
      n: "schedule"
      r: true
      sh: "A cron expression with its time zone, or an interval in seconds from an anchor time"
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    settings_changed_at: {
      h: "Settings Changed At"
      n: "settings_changed_at"
      r: true
      sh: "When a person or the agent last changed the run settings; sent back with a change"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    skipped_today: {
      h: "Skipped Today"
      n: "skipped_today"
      r: true
      sh: "Events skipped today, over the daily limit or while paused"
      t: "`$INTEGER`"
    }
    stale_at: {
      h: "Stale At"
      n: "stale_at"
      r: true
      sh: "When the workflow was paused; it starts nothing until resumed"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
