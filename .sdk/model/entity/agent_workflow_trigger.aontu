# Entity: agent_workflow_trigger

main: kit: entity: agent_workflow_trigger: {

  alias: field: {}

  fields: {
    budget: {
      h: "Budget"
      n: "budget"
      r: true
      sh: "Each run's limits, and what the trigger may spend per period with its runs' spend in the current one"
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    can_manage: {
      h: "Can Manage"
      n: "can_manage"
      r: true
      t: "`$BOOLEAN`"
    }
    can_pause: {
      h: "Can Pause"
      n: "can_pause"
      r: true
      sh: "It is running, so a manager can pause it"
      t: "`$BOOLEAN`"
    }
    can_resume: {
      h: "Can Resume"
      n: "can_resume"
      r: true
      sh: "A person paused it, so a manager can resume it"
      t: "`$BOOLEAN`"
    }
    can_review: {
      h: "Can Review"
      n: "can_review"
      r: true
      sh: "The file changed and nobody checked it, so a manager can review it and resume"
      t: "`$BOOLEAN`"
    }
    daily_limit: {
      h: "Daily Limit"
      n: "daily_limit"
      r: true
      sh: "How many events a day may start an event workflow's runs"
      t: [
        "`$ONE`"
        [
          "`$INTEGER`"
          "`$NULL`"
        ]
      ]
    }
    day_resets_at: {
      h: "Day Resets At"
      n: "day_resets_at"
      r: true
      sh: "When the daily count starts again, at the organization's midnight"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
    kind: {
      h: "Kind"
      n: "kind"
      r: true
      t: "`$STRING`"
    }
