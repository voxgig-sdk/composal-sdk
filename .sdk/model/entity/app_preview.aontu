      t: "`$STRING`"
    }
    expected_generation: {
      h: "Expected Generation"
      n: "expected_generation"
      r: false
      sh: "Required for resource_overrides, storage_binding_resources, shared_service_binding_ids or shared_data_binding_ids; stale generations return 409."
      t: "`$INTEGER`"
    }
    expected_patchset: {
      h: "Expected Patchset"
      n: "expected_patchset"
      r: false
      sh: "Optional public Change patchset fence; stale selections return 409."
