      r: true
      t: "`$STRING`"
    }
    source_ref: {
      h: "Source Ref"
      n: "source_ref"
      r: false
      t: "`$STRING`"
    }
    storage_binding_resources: {
      h: "Storage Binding Resources"
      n: "storage_binding_resources"
      r: false
