      h: "Member Count"
      n: "member_count"
      r: true
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        patch: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
