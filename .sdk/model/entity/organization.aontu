        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    sandbox_region: {
      h: "Sandbox Region"
      n: "sandbox_region"
      op: {
        patch: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
