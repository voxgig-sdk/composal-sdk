      h: "Google Workspace Domain"
      n: "google_workspace_domain"
      r: false
      sh: "Owners can approve their verified Google Workspace domain, or send null to disable automatic joining."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
