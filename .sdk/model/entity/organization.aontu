# Entity: organization

main: kit: entity: organization: {

  alias: field: {}

  fields: {
    activated_products: {
      h: "Activated Products"
      n: "activated_products"
      r: true
      sh: "Products this organization has activated (PRD 144)."
      t: "`$ARRAY`"
    }
    agents_only: {
      h: "Agents Only"
      n: "agents_only"
      r: false
      sh: "Whether this organization uses the agents-only interface; older responses may omit this value."
      t: "`$BOOLEAN`"
    }
    can_activate_products: {
      h: "Can Activate Products"
      n: "can_activate_products"
      r: true
      sh: "Whether the current user may activate a product for this organization: the organization-admin rule the activation endpoint enforces."
      t: "`$BOOLEAN`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    created_at_label: {
      h: "Created At Label"
      n: "created_at_label"
      r: true
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
