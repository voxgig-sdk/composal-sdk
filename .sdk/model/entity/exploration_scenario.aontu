# Entity: exploration_scenario

main: kit: entity: exploration_scenario: {

  alias: field: {}

  fields: {
    agent_filters: {
      h: "Agent Filters"
      n: "agent_filters"
      r: true
      sh: "Status counts and matching agent IDs for every filter in this live snapshot."
      t: "`$OBJECT`"
    }
    agents: {
      h: "Agents"
      n: "agents"
      r: true
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 6
      }
    }
    can_continue: {
      h: "Can Continue"
      n: "can_continue"
      r: false
      sh: "Whether a finished run can be resumed through the orchestrator."
      t: "`$BOOLEAN`"
    }
    chat_messages: {
      h: "Chat Messages"
      n: "chat_messages"
      r: false
      t: "`$ARRAY`"
    }
    concurrency: {
      h: "Concurrency"
      n: "concurrency"
      r: true
      t: "`$INTEGER`"
    }
    covered_areas: {
      h: "Covered Areas"
      n: "covered_areas"
      r: true
      sh: "Titles of the testers that reported checks, in team order; areas assigned to testers that never ran are left out."
      t: "`$ARRAY`"
    }
    created_at: {
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    deadline_at: {
      h: "Deadline At"
      n: "deadline_at"
      r: true
      t: "`$STRING`"
    }
    demo_project: {
      h: "Demo Project"
      n: "demo_project"
      r: true
      sh: "The workspace's copy of the demo project, linked from the free first discovery as an example; null for other runs or without one."
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    ended_early: {
      h: "Ended Early"
      n: "ended_early"
      r: true
      sh: "Whether a partial run stopped before its team did its work: no tester completed or reported a check and no agent reported a finding, as when the lead stopped at sign-in, or inference failed."
      t: "`$BOOLEAN`"
    }
    environment_id: {
      h: "Environment Id"
      n: "environment_id"
      r: true
      t: "`$STRING`"
    }
    environment_name: {
      h: "Environment Name"
      n: "environment_name"
      r: true
      t: "`$STRING`"
    }
    explorer_activity: {
      h: "Explorer Activity"
      n: "explorer_activity"
      r: true
      sh: "What the team is doing now."
      t: "`$OBJECT`"
    }
    finding_count: {
      h: "Finding Count"
      n: "finding_count"
      r: true
      sh: "Findings at every priority, locked ones included."
      t: "`$INTEGER`"
    }
    findings: {
      h: "Findings"
      n: "findings"
      r: true
      sh: "Every tester's findings, most severe first, with the checks each one cites."
      t: "`$ARRAY`"
    }
    findings_fix_prompt: {
      h: "Findings Fix Prompt"
      n: "findings_fix_prompt"
      r: true
      sh: "One coding-agent prompt covering every finding, most severe first."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    finished_at: {
      h: "Finished At"
      n: "finished_at"
      r: false
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    goal: {
      h: "Goal"
      n: "goal"
      r: true
      t: "`$STRING`"
    }
    huntable_flows: {
      de: true
      h: "Huntable Flows"
      n: "huntable_flows"
      r: true
      sh: "Deprecated alias of scannable_flows, kept for released CLIs."
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
    max_seconds: {
      h: "Max Seconds"
      n: "max_seconds"
      r: true
      t: "`$INTEGER`"
    }
    max_testers: {
      h: "Max Testers"
      n: "max_testers"
      r: true
      t: "`$INTEGER`"
    }
    mode: {
      h: "Mode"
      n: "mode"
      r: false
      t: "`$STRING`"
    }
    next_scan_improvements: {
      h: "Next Scan Improvements"
      n: "next_scan_improvements"
      r: true
      sh: "The optional setup the first scan's page offers for a better next scan, in order: a test account for a run without one, a repository except for a Deep Scan, and a plan."
      t: "`$ARRAY`"
    }
    observed_at: {
      h: "Observed At"
      n: "observed_at"
      r: false
      sh: "Time this run snapshot was read; distinct from browser activity timestamps."
      t: "`$STRING`"
    }
    onboarding: {
      h: "Onboarding"
      n: "onboarding"
      r: true
      sh: "Whether this is the workspace's free first discovery, started by setup."
      t: "`$BOOLEAN`"
    }
    paywalled: {
      h: "Paywalled"
      n: "paywalled"
      r: true
      sh: "Whether this is the workspace's included Deep Scan (verify_onboarding_deep_scan), or a rerun of it, while the workspace has not paid."
      t: "`$BOOLEAN`"
    }
    permissions: {
      h: "Permissions"
      n: "permissions"
      r: true
      t: "`$OBJECT`"
    }
    priority_counts: {
      h: "Priority Counts"
      n: "priority_counts"
      r: true
      t: "`$OBJECT`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: false
      sh: "Set when the exploration targets a project environment."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    related_explorations: {
      h: "Related Explorations"
      n: "related_explorations"
      r: true
      t: "`$ARRAY`"
    }
    report: {
      h: "Report"
      n: "report"
      r: true
      t: "`$OBJECT`"
    }
    reproduction_of: {
      h: "Reproduction Of"
      n: "reproduction_of"
      r: true
      sh: "The Deep Scan or Discovery and reported bug this scan reruns in a fresh browser."
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    reproductions: {
      h: "Reproductions"
      n: "reproductions"
      r: true
      sh: "Fresh-browser reruns of this scan's reported bugs."
      t: "`$ARRAY`"
    }
    saves_scenarios: {
      h: "Saves Scenarios"
      n: "saves_scenarios"
      r: true
      sh: "Whether this exploration has started saving scenarios."
      t: "`$BOOLEAN`"
    }
    scannable_flows: {
      h: "Scannable Flows"
      n: "scannable_flows"
      r: true
      sh: "Flows a finished exploration recorded that deep scans can start from."
      t: "`$ARRAY`"
    }
    scenario_generation: {
      h: "Scenario Generation"
      n: "scenario_generation"
      r: true
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 2
        depth: 6
      }
    }
    sign_in_needs_answer: {
      h: "Sign In Needs Answer"
      n: "sign_in_needs_answer"
      r: true
      sh: "Whether a sign-in check needs the person's answer next: its agent waits in its browser with no reply on the way, or the check ended on an unanswered question and an answer starts the agent again."
      t: "`$BOOLEAN`"
    }
    sign_in_outcome: {
      h: "Sign In Outcome"
      n: "sign_in_outcome"
      r: true
      sh: "A sign-in check's outcome; null for other runs."
      t: "`$STRING`"
    }
    sign_in_question: {
      h: "Sign In Question"
      n: "sign_in_question"
      r: false
      sh: "What a sign-in check's agent asked the person while it needs their answer; null otherwise and for other runs."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    startup_retryable: {
      h: "Startup Retryable"
      n: "startup_retryable"
      r: false
      sh: "Failed browser startup can be retried without extending the original deadline or tester budget."
      t: "`$BOOLEAN`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      t: "`$STRING`"
    }
    time_limit_reached: {
      h: "Time Limit Reached"
      n: "time_limit_reached"
      r: true
      sh: "Whether a partial run ended because it used its whole time budget, rather than stopping early."
      t: "`$BOOLEAN`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "The page's title; the workspace's included Deep Scan is named for the app it tested, as in `Free scan of acme.example.com`."
      t: "`$STRING`"
    }
    unlock: {
      h: "Unlock"
      n: "unlock"
      r: true
      sh: "Once a paywalled scan ends, whether a paid plan would unlock its locked findings and whether this person may choose one, as on its findings page."
      t: "`$ANY`"
    }
    web_url: {
      h: "Web Url"
      n: "web_url"
      r: true
      sh: "The run's page in the Composal web app"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "exploration_scenario"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: false
          co: {
            id: "POST /api/v1/organizations/{organization_id}/verify/explorations/{id}/scenarios"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "exploration_id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "organization_id"
                or: "organization_id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                explode: true
                k: "query"
                n: "project_id"
                or: "project_id"
                r: false
                style: "form"
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/api/v1/organizations/{organization_id}/verify/explorations/{id}/scenarios"
          q: {
            exist: [
              "exploration_id"
              "organization_id"
            ]
          }
          r: {
            param: {
              id: "exploration_id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "organizations"
            }
            {
              var: "organization_id"
            }
            {
              lit: "verify"
            }
            {
              lit: "explorations"
            }
            {
              var: "exploration_id"
            }
            {
              lit: "scenarios"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.organization") path("$.main.kit.entity.exploration")]
  ]

}
