    local_agent_control_available: {
      h: "Local Agent Control Available"
      n: "local_agent_control_available"
      r: false
      sh: "Whether this organization exposes paired local coding-agent control."
      t: "`$BOOLEAN`"
    }
    managers: {
      h: "Managers"
      n: "managers"
      r: false
      sh: "Teammates named as managers beside the owner."
      t: "`$ARRAY`"
    }
    model_change_action: {
      h: "Model Change Action"
      n: "model_change_action"
      r: false
      sh: "Advisory composer action."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
