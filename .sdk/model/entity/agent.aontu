# Entity: agent

main: kit: entity: agent: {

  alias: field: {}

  fields: {
    attention: {
      h: "Attention"
      n: "attention"
      r: true
      sh: "Whether this agent waits on its viewer, decided from its provisioning, decisions awaiting an answer, the outcome of its last reported run and the model's verdict on its last reply (question when reply_triage is needs_you)."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    avatar: {
      h: "Avatar"
      n: "avatar"
      r: false
      sh: "Emoji or up to two visible grapheme clusters, at most 64 UTF-8 bytes, without control or bidi override characters."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    can_delete: {
      h: "Can Delete"
      n: "can_delete"
      r: false
      sh: "Whether this viewer may delete this v2 agent."
      t: "`$BOOLEAN`"
    }
    can_edit_configuration: {
      h: "Can Edit Configuration"
      n: "can_edit_configuration"
      r: true
      t: "`$BOOLEAN`"
    }
    can_manage: {
      h: "Can Manage"
      n: "can_manage"
      r: true
      t: "`$BOOLEAN`"
    }
    can_manage_sharing: {
      h: "Can Manage Sharing"
      n: "can_manage_sharing"
      r: false
      t: "`$BOOLEAN`"
    }
    can_name_managers: {
      h: "Can Name Managers"
      n: "can_name_managers"
      r: false
      sh: "Whether the viewer may name managers now."
      t: "`$BOOLEAN`"
    }
    can_queue_input: {
      h: "Can Queue Input"
      n: "can_queue_input"
      r: false
      sh: "Current V2 authority to admit a durable input independently of native readiness."
      t: "`$BOOLEAN`"
    }
    can_reconcile_save: {
      h: "Can Reconcile Save"
      n: "can_reconcile_save"
      r: true
      sh: "May reconcile an identical previously accepted save; this does not authorize new configuration edits."
      t: "`$BOOLEAN`"
    }
    configuration: {
      h: "Configuration"
      n: "configuration"
      op: {
        create: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      t: "`$ANY`"
      union: {
        branches: 5
        count: 3
        depth: 9
      }
    }
    configuration_revision: {
      h: "Configuration Revision"
      n: "configuration_revision"
      r: true
      t: "`$INTEGER`"
    }
    configuration_version: {
      h: "Configuration Version"
      n: "configuration_version"
      r: true
      sh: "Opaque version token."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    control_connections_available: {
      h: "Control Connections Available"
      n: "control_connections_available"
      r: false
      sh: "Whether this viewer may manage their own external Control connections, including cleanup while the agent is paused."
      t: "`$BOOLEAN`"
    }
    controlling_user_id: {
      h: "Controlling User Id"
      n: "controlling_user_id"
      r: true
      t: "`$STRING`"
    }
    coordination_available: {
      h: "Coordination Available"
      n: "coordination_available"
      r: false
      sh: "Durable task controls remain available even when native conversation history is unavailable."
      t: "`$BOOLEAN`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    direct_chat_available: {
      h: "Direct Chat Available"
      n: "direct_chat_available"
      r: false
      sh: "Advisory availability of direct V1 chat."
      t: "`$BOOLEAN`"
    }
    has_unread_updates: {
      h: "Has Unread Updates"
      n: "has_unread_updates"
      r: true
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
    last_reply_at: {
      fo: "date-time"
      h: "Last Reply At"
      n: "last_reply_at"
      r: true
      sh: "When the agent's latest projected reply arrived, for grouping recent replies."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    lifecycle_actions: {
      h: "Lifecycle Actions"
      n: "lifecycle_actions"
