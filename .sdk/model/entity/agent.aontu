    }
    sharing_version: {
      h: "Sharing Version"
      n: "sharing_version"
      r: false
      t: "`$INTEGER`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Optional explicit API alias."
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      t: "`$STRING`"
    }
    team_role: {
      h: "Team Role"
      n: "team_role"
      r: false
