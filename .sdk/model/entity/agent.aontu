    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      t: "`$STRING`"
    }
    url_slug: {
      h: "Url Slug"
      n: "url_slug"
      r: false
      sh: "Stable organization-scoped browser name for /ORG/agent/NAME."
      t: "`$STRING`"
    }
    visibility: {
      h: "Visibility"
      n: "visibility"
      r: false
      sh: "Defaults to organization."
      t: "`$STRING`"
    }
  }

