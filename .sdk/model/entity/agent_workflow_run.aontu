# Entity: agent_workflow_run

main: kit: entity: agent_workflow_run: {

  alias: field: {}

  fields: {
    action: {
      h: "Action"
      n: "action"
      r: true
      t: "`$STRING`"
    }
    automation: {
      h: "Automation"
      n: "automation"
      r: false
      sh: "Saved native automation identity."
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    budget_seconds: {
      h: "Budget Seconds"
      n: "budget_seconds"
      r: true
      sh: "The run stops once it has been running this long"
      t: [
        "`$ONE`"
        [
          "`$INTEGER`"
          "`$NULL`"
        ]
      ]
    }
    budget_usd: {
      h: "Budget Usd"
      n: "budget_usd"
      r: true
      sh: "The run stops before a step once it has spent this much"
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    can_answer: {
      h: "Can Answer"
      n: "can_answer"
      r: true
      sh: "Whether this viewer can answer the step that stopped the run; the answer runs that step again"
      t: "`$BOOLEAN`"
    }
    can_approve: {
      h: "Can Approve"
      n: "can_approve"
      r: true
      sh: "Whether this viewer can approve or decline the checkpoint the run waits at; only a person can approve one"
      t: "`$BOOLEAN`"
    }
    can_dismiss: {
      h: "Can Dismiss"
      n: "can_dismiss"
      r: true
      sh: "Whether this viewer can dismiss the run waiting for them, which ends it unanswered"
      t: "`$BOOLEAN`"
    }
    checkpoint: {
      h: "Checkpoint"
      n: "checkpoint"
      r: true
      sh: "The question a run waiting at a checkpoint is asking"
      t: [
        "`$ONE`"
        [
          "`$OBJECT`"
          "`$NULL`"
        ]
      ]
    }
    conversation_id: {
      h: "Conversation Id"
      n: "conversation_id"
      r: true
      sh: "The thread the run works in, which the person opens to follow it"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    decision_history: {
      h: "Decision History"
      n: "decision_history"
      r: false
      t: "`$OBJECT`"
    }
    error: {
      h: "Error"
      n: "error"
      r: true
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
