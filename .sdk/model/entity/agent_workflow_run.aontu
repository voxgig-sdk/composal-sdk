      h: "Finished At"
      n: "finished_at"
      r: true
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    flow_steps: {
      h: "Flow Steps"
      n: "flow_steps"
      r: true
      sh: "How the run went at each step of its workflow file, in the order it reached them; null when steps were recorded without their step of the file"
      t: [
        "`$ONE`"
        [
          "`$ARRAY`"
          "`$NULL`"
        ]
      ]
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Public run ID."
      t: "`$STRING`"
    }
    needs_you: {
      h: "Needs You"
      n: "needs_you"
      r: true
      sh: "Whether a step stopped the run for the person, who can answer it"
      t: "`$BOOLEAN`"
    }
    note: {
      h: "Note"
      n: "note"
      r: true
      sh: "One sentence a workflow step left for the person, which the run's card leads with"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    nothing_to_do_reason: {
      h: "Nothing To Do Reason"
      n: "nothing_to_do_reason"
      r: true
      sh: "Why a run that succeeded did no work, as the step that found nothing to do said; null otherwise."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    resume_count: {
      h: "Resume Count"
      n: "resume_count"
      r: true
      sh: "How many times the run went on from a checkpoint; it tells one pause from the next, even at the same checkpoint"
      t: "`$INTEGER`"
    }
    retry_step_id: {
      h: "Retry Step Id"
      n: "retry_step_id"
      r: true
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    running_seconds: {
      h: "Running Seconds"
      n: "running_seconds"
      r: true
      sh: "How long the run has been running, not counting time waiting at a checkpoint or for a retry"
      t: "`$INTEGER`"
    }
    source: {
      h: "Source"
      n: "source"
      r: true
      t: "`$STRING`"
    }
    spent_tokens: {
      h: "Spent Tokens"
      n: "spent_tokens"
      r: true
