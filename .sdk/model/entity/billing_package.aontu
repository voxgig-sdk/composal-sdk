# Entity: billing_package

main: kit: entity: billing_package: {

  alias: field: {}

  fields: {
    addons: {
      h: "Addons"
      n: "addons"
      r: true
      t: "`$ARRAY`"
    }
    base_price_cents: {
      h: "Base Price Cents"
      n: "base_price_cents"
      r: true
      t: "`$INTEGER`"
    }
    billing_interval: {
      h: "Billing Interval"
      n: "billing_interval"
      r: true
      t: "`$STRING`"
    }
    billing_policy: {
      h: "Billing Policy"
      n: "billing_policy"
      r: true
      t: "`$STRING`"
    }
    ci_included_spend_cents: {
      h: "Ci Included Spend Cents"
      n: "ci_included_spend_cents"
      r: false
      sh: "Monthly USD credit in cents shared by all CI charges, including runners, cache, storage and add-ons; replaces CI unit allowances when positive."
      t: "`$INTEGER`"
    }
    currency: {
      h: "Currency"
      n: "currency"
      r: true
      t: "`$STRING`"
    }
    key: {
      h: "Key"
      n: "key"
      r: true
      t: "`$STRING`"
    }
    max_seats: {
      h: "Max Seats"
      n: "max_seats"
      r: false
      t: [
        "`$ONE`"
        [
          "`$INTEGER`"
          "`$NULL`"
        ]
      ]
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      t: "`$STRING`"
    }
    pay_as_you_go_enabled: {
      h: "Pay As You Go Enabled"
      n: "pay_as_you_go_enabled"
      r: true
      t: "`$BOOLEAN`"
    }
    rates: {
      h: "Rates"
      n: "rates"
      r: true
      t: "`$ARRAY`"
    }
    revision: {
      h: "Revision"
      n: "revision"
      r: true
      t: "`$INTEGER`"
    }
    roder_daily_run_limit: {
      h: "Roder Daily Run Limit"
      n: "roder_daily_run_limit"
      r: false
      t: "`$INTEGER`"
    }
    roder_run_concurrency_limit: {
      h: "Roder Run Concurrency Limit"
      n: "roder_run_concurrency_limit"
      r: false
      t: "`$INTEGER`"
    }
    seat_price_cents: {
      h: "Seat Price Cents"
      n: "seat_price_cents"
      r: true
      t: "`$INTEGER`"
    }
    trial_days: {
      h: "Trial Days"
      n: "trial_days"
      r: true
      t: "`$INTEGER`"
    }
    visibility: {
      h: "Visibility"
      n: "visibility"
      r: true
      t: "`$STRING`"
    }
  }

  name: "billing_package"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/billing/packages"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/v1/billing/packages"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "billing"
            }
            {
              lit: "packages"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.packages`"
          }
        }
      ]
    }
  }



}
