                style: "form"
                t: "`$STRING`"
              }
              {
                explode: true
                k: "query"
                n: "owner"
                or: "owner"
                r: true
                style: "form"
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/github/repository_lookup"
          q: {
            "$action": "repository_lookup"
            exist: [
              "name"
              "owner"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "github"
            }
            {
              lit: "repository_lookup"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  fields: {
  }



}
