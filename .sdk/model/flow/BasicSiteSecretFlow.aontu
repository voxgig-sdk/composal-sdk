# BasicSiteSecretFlow

main: kit: flow: BasicSiteSecretFlow:
{
  entity: "site_secret",
  kind: "basic",
  name: "BasicSiteSecretFlow",
  step: [
    {
      d: {
        organization_id: "organization01",
        site_id: "site01"
      }

      i: {
        ref: "site_secret_ref01",
        srcdatavar: "site_secret_ref01_data",
        suffix: "_up0",
        textfield: "native_agent_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-site_secret_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSiteSecretFlow"
}