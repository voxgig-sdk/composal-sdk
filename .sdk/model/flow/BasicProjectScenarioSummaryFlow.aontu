  entity: "project_scenario_summary",
  kind: "basic",
  name: "BasicProjectScenarioSummaryFlow",
  step: [
    {
      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_scenario_summary_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectScenarioSummaryFlow"
}