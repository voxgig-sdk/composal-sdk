# BasicVcsSettingFlow

main: kit: flow: BasicVcsSettingFlow:
{
  entity: "vcs_setting",
  kind: "basic",
  name: "BasicVcsSettingFlow",
  step: [
    {
      i: {
        ref: "vcs_setting_ref01",
        srcdatavar: "vcs_setting_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "vcs_setting01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-vcs_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVcsSettingFlow"
}