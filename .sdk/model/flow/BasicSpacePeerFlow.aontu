# BasicSpacePeerFlow

main: kit: flow: BasicSpacePeerFlow:
{
  entity: "space_peer",
  kind: "basic",
  name: "BasicSpacePeerFlow",
  step: [
    {
      i: {
        ref: "space_peer_ref01"
      }

      m: {
        space_id: "space01"
      }

      o: "create"
    }

    {
      d: {
        space_id: "space01"
      }

      i: {
        ref: "space_peer_ref01",
        srcdatavar: "space_peer_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-space_peer_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "space_peer_ref01",
        srcdatavar: "space_peer_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "space_peer01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-space_peer_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "space_peer_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "space_peer01",
        space_id: "space01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicSpacePeerFlow"
}