# BasicGitReviewIdentityFlow

main: kit: flow: BasicGitReviewIdentityFlow:
{
  entity: "git_review_identity",
  kind: "basic",
  name: "BasicGitReviewIdentityFlow",
  step: [
    {
      i: {
        ref: "git_review_identity_ref01",
        srcdatavar: "git_review_identity_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "git_review_identity01",
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-git_review_identity_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGitReviewIdentityFlow"
}