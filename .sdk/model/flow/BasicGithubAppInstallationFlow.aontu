# BasicGithubAppInstallationFlow

main: kit: flow: BasicGithubAppInstallationFlow:
{
  entity: "github_app_installation",
  kind: "basic",
  name: "BasicGithubAppInstallationFlow",
  step: [
    {
      i: {
        ref: "github_app_installation_ref01"
      }

      m: {
        id: "id01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "github_app_installation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "github_app_installation_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "github_app_installation01",
        organization_id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "github_app_installation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGithubAppInstallationFlow"
}