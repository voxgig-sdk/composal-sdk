# BasicChangeCommentFlow

main: kit: flow: BasicChangeCommentFlow:
{
  entity: "change_comment",
  kind: "basic",
  name: "BasicChangeCommentFlow",
  step: [
    {
      i: {
        ref: "change_comment_ref01"
      }

      m: {
        change_id: "change01",
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "create"
    }

    {
      i: {
        ref: "change_comment_ref01",
        srcdatavar: "change_comment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "change_comment01",
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-change_comment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicChangeCommentFlow"
}