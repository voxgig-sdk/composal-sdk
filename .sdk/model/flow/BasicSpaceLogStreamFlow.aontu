# BasicSpaceLogStreamFlow

main: kit: flow: BasicSpaceLogStreamFlow:
{
  entity: "space_log_stream",
  kind: "basic",
  name: "BasicSpaceLogStreamFlow",
  step: [
    {
      i: {
        ref: "space_log_stream_ref01"
      }

      m: {
        space_id: "space01"
      }

      o: "create"
    }

    {
      i: {
        ref: "space_log_stream_ref01",
        srcdatavar: "space_log_stream_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "space_log_stream01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-space_log_stream_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSpaceLogStreamFlow"
}