# BasicAgentFileFlow

main: kit: flow: BasicAgentFileFlow:
{
  entity: "agent_file",
  kind: "basic",
  name: "BasicAgentFileFlow",
  step: [
    {
      i: {
        ref: "agent_file_ref01",
        srcdatavar: "agent_file_ref01_data",
        suffix: "_dt0"
      }

      m: {
        agent_id: "agent01",
        id: "agent_file01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_file_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentFileFlow"
}