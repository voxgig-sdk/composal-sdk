# BasicAgentRoutineFlow

main: kit: flow: BasicAgentRoutineFlow:
{
  entity: "agent_routine",
  kind: "basic",
  name: "BasicAgentRoutineFlow",
  step: [
    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_routine_ref01"
          }
        }
      ]
    }

    {
      d: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      i: {
        ref: "agent_routine_ref01",
        srcdatavar: "agent_routine_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_routine_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentRoutineFlow"
}