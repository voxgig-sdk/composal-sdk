# BasicProjectSettingFlow

main: kit: flow: BasicProjectSettingFlow:
{
  entity: "project_setting",
  kind: "basic",
  name: "BasicProjectSettingFlow",
  step: [
    {
      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectSettingFlow"
}