# BasicProjectSettingFlow

main: kit: flow: BasicProjectSettingFlow:
{
  entity: "project_setting",
  kind: "basic",
  name: "BasicProjectSettingFlow",
  step: [
    {
      i: {
        ref: "project_setting_ref01",
        srcdatavar: "project_setting_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "project_setting01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectSettingFlow"
}