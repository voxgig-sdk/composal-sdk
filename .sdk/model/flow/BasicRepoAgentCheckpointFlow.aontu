# BasicRepoAgentCheckpointFlow

main: kit: flow: BasicRepoAgentCheckpointFlow:
{
  entity: "repo_agent_checkpoint",
  kind: "basic",
  name: "BasicRepoAgentCheckpointFlow",
  step: [
    {
      i: {
        ref: "repo_agent_checkpoint_ref01",
        srcdatavar: "repo_agent_checkpoint_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "repo_agent_checkpoint01",
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repo_agent_checkpoint_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepoAgentCheckpointFlow"
}