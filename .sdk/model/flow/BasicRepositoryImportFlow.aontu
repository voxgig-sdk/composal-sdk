# BasicRepositoryImportFlow

main: kit: flow: BasicRepositoryImportFlow:
{
  entity: "repository_import",
  kind: "basic",
  name: "BasicRepositoryImportFlow",
  step: [
    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "repository_import_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepositoryImportFlow"
}