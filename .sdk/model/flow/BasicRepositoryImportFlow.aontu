  name: "BasicRepositoryImportFlow",
  step: [
    {
      i: {
        ref: "repository_import_ref01",
        srcdatavar: "repository_import_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "repository_import01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repository_import_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepositoryImportFlow"
}