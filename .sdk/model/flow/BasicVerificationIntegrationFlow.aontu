# BasicVerificationIntegrationFlow

main: kit: flow: BasicVerificationIntegrationFlow:
{
  entity: "verification_integration",
  kind: "basic",
  name: "BasicVerificationIntegrationFlow",
  step: [
    {
      i: {
        ref: "verification_integration_ref01",
        srcdatavar: "verification_integration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "verification_integration01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-verification_integration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVerificationIntegrationFlow"
}