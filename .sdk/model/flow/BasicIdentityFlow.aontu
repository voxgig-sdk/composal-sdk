# BasicIdentityFlow

main: kit: flow: BasicIdentityFlow:
{
  entity: "identity",
  kind: "basic",
  name: "BasicIdentityFlow",
  step: [
    {
      i: {
        ref: "identity_ref01"
      }

      m: {
        organization_id: "organization01",
        secret_id: "secret01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "identity_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "identity_ref01",
        srcdatavar: "identity_ref01_data",
        suffix: "_up0",
        textfield: "app_environment_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-identity_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "identity_ref01",
        srcdatavar: "identity_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "identity01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-identity_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "identity_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "identity01",
        organization_id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "identity_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIdentityFlow"
}