# BasicAgentLibraryFlow

main: kit: flow: BasicAgentLibraryFlow:
{
  entity: "agent_library",
  kind: "basic",
  name: "BasicAgentLibraryFlow",
  step: [
    {
      i: {
        ref: "agent_library_ref01",
        srcdatavar: "agent_library_ref01_data",
        suffix: "_dt0"
      }

      m: {
        agent_id: "agent01",
        id: "agent_library01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_library_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentLibraryFlow"
}