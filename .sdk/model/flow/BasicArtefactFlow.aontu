# BasicArtefactFlow

main: kit: flow: BasicArtefactFlow:
{
  entity: "artefact",
  kind: "basic",
  name: "BasicArtefactFlow",
  step: [
    {
      i: {
        ref: "artefact_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "artefact_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "artefact_ref01",
        srcdatavar: "artefact_ref01_data",
        suffix: "_up0",
        textfield: "automation_invocation_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-artefact_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "artefact_ref01",
        srcdatavar: "artefact_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "artefact01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-artefact_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "artefact_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "artefact01",
        organization_id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "artefact_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicArtefactFlow"
}