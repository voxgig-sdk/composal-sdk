# BasicSpaceAuditEventFlow

main: kit: flow: BasicSpaceAuditEventFlow:
{
  entity: "space_audit_event",
  kind: "basic",
  name: "BasicSpaceAuditEventFlow",
  step: [
    {
      i: {
        ref: "space_audit_event_ref01"
      }

      m: {
        space_id: "space01"
      }

      o: "create"
    }

    {
      i: {
        ref: "space_audit_event_ref01",
        srcdatavar: "space_audit_event_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "space_audit_event01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-space_audit_event_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSpaceAuditEventFlow"
}