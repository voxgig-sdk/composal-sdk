# BasicPageArtefactFlow

main: kit: flow: BasicPageArtefactFlow:
{
  entity: "page_artefact",
  kind: "basic",
  name: "BasicPageArtefactFlow",
  step: [
    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "page_artefact_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "page_artefact_ref01",
        srcdatavar: "page_artefact_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "page_artefact01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-page_artefact_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPageArtefactFlow"
}