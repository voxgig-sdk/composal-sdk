# BasicPairingFlow

main: kit: flow: BasicPairingFlow:
{
  entity: "pairing",
  kind: "basic",
  name: "BasicPairingFlow",
  step: [
    {
      i: {
        ref: "pairing_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
