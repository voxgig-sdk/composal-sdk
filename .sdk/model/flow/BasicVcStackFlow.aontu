# BasicVcStackFlow

main: kit: flow: BasicVcStackFlow:
{
  entity: "vc_stack",
  kind: "basic",
  name: "BasicVcStackFlow",
  step: [
    {
      m: {
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "vc_stack_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01",
        repo_id: "repo01"
      }

      i: {
        ref: "vc_stack_ref01",
        srcdatavar: "vc_stack_ref01_data",
        suffix: "_up0",
        textfield: "alias_ref_name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-vc_stack_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "vc_stack_ref01",
        srcdatavar: "vc_stack_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "vc_stack01",
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-vc_stack_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVcStackFlow"
}