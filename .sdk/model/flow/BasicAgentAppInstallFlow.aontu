# BasicAgentAppInstallFlow

main: kit: flow: BasicAgentAppInstallFlow:
{
  entity: "agent_app_install",
  kind: "basic",
  name: "BasicAgentAppInstallFlow",
  step: [
    {
      d: {
        agent_app_id: "agent_app01",
        organization_id: "organization01"
      }

      i: {
        ref: "agent_app_install_ref01",
        srcdatavar: "agent_app_install_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_app_install_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentAppInstallFlow"
}