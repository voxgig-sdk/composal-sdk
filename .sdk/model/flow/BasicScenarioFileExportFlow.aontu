  kind: "basic",
  name: "BasicScenarioFileExportFlow",
  step: [
    {
      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "scenario_file_export_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicScenarioFileExportFlow"
}