# BasicProjectRecordingFlow

main: kit: flow: BasicProjectRecordingFlow:
{
  entity: "project_recording",
  kind: "basic",
  name: "BasicProjectRecordingFlow",
  step: [
    {
      i: {
        ref: "project_recording_ref01"
      }

      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "create"
    }

    {
      i: {
        ref: "project_recording_ref01",
        srcdatavar: "project_recording_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "project_recording01",
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_recording_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "project_recording_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "project_recording01",
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicProjectRecordingFlow"
}