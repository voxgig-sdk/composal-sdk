# BasicDreamFlow

main: kit: flow: BasicDreamFlow:
{
  entity: "dream",
  kind: "basic",
  name: "BasicDreamFlow",
  step: [
    {
      i: {
        ref: "dream_ref01"
      }

      m: {
        id: "id01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "dream_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dream_ref01",
        srcdatavar: "dream_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "dream01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dream_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDreamFlow"
}