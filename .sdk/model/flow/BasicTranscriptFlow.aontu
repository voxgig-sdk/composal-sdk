# BasicTranscriptFlow

main: kit: flow: BasicTranscriptFlow:
{
  entity: "transcript",
  kind: "basic",
  name: "BasicTranscriptFlow",
  step: [
    {
      i: {
        ref: "transcript_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "transcript_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "transcript_ref01",
        srcdatavar: "transcript_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-transcript_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTranscriptFlow"
}