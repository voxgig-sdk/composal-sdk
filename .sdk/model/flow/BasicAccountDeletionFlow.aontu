# BasicAccountDeletionFlow

main: kit: flow: BasicAccountDeletionFlow:
{
  entity: "account_deletion",
  kind: "basic",
  name: "BasicAccountDeletionFlow",
  step: [
    {
      i: {
        ref: "account_deletion_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "account_deletion_ref01",
        srcdatavar: "account_deletion_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_deletion_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccountDeletionFlow"
}