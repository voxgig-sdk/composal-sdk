# BasicProjectOverviewFlow

main: kit: flow: BasicProjectOverviewFlow:
{
  entity: "project_overview",
  kind: "basic",
  name: "BasicProjectOverviewFlow",
  step: [
    {
      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_overview_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectOverviewFlow"
}