# BasicAuthPasswordResetFlow

main: kit: flow: BasicAuthPasswordResetFlow:
{
  entity: "auth_password_reset",
  kind: "basic",
  name: "BasicAuthPasswordResetFlow",
  step: [
    {
      i: {
        ref: "auth_password_reset_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "auth_password_reset_ref01",
        srcdatavar: "auth_password_reset_ref01_data",
        suffix: "_up0",
        textfield: "email"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-auth_password_reset_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAuthPasswordResetFlow"
}