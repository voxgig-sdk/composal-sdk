# BasicClawderFlow

main: kit: flow: BasicClawderFlow:
{
  entity: "clawder",
  kind: "basic",
  name: "BasicClawderFlow",
  step: [
    {
      i: {
        ref: "clawder_ref01"
      }

      m: {
        agent_id: "agent01",
        name: "name01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "clawder_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "clawder_ref01",
        srcdatavar: "clawder_ref01_data",
        suffix: "_up0",
        textfield: "account_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-clawder_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "clawder_ref01",
        srcdatavar: "clawder_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-clawder_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "clawder_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "clawder01",
        organization_id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "clawder_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicClawderFlow"
}