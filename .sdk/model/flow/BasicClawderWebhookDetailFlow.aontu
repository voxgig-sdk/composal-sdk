        id: "clawder_webhook_detail01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-clawder_webhook_detail_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicClawderWebhookDetailFlow"
}