# BasicAgentSubscriptionFlow

main: kit: flow: BasicAgentSubscriptionFlow:
{
  entity: "agent_subscription",
  kind: "basic",
  name: "BasicAgentSubscriptionFlow",
  step: [
    {
      i: {
        ref: "agent_subscription_ref01"
      }

      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "agent_subscription_ref01",
        srcdatavar: "agent_subscription_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent_subscription01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_subscription_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentSubscriptionFlow"
}