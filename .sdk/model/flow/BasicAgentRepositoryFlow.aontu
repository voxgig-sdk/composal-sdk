# BasicAgentRepositoryFlow

main: kit: flow: BasicAgentRepositoryFlow:
{
  entity: "agent_repository",
  kind: "basic",
  name: "BasicAgentRepositoryFlow",
  step: [
    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "agent_repository_ref01",
        srcdatavar: "agent_repository_ref01_data",
        suffix: "_up0",
        textfield: "repository_choices_error"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_repository_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_repository_ref01",
        srcdatavar: "agent_repository_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent_repository01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_repository_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentRepositoryFlow"
}