# BasicAppLocationFlow

main: kit: flow: BasicAppLocationFlow:
{
  entity: "app_location",
  kind: "basic",
  name: "BasicAppLocationFlow",
  step: [
    {
      i: {
        ref: "app_location_ref01"
      }

      m: {
        app_id: "app01"
      }

      o: "create"
    }

    {
      m: {
        app_id: "app01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "app_location_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "app_location_ref01",
        suffix: "_rm0"
      }

      m: {
        app_id: "app01",
        id: "app_location01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        app_id: "app01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "app_location_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAppLocationFlow"
}