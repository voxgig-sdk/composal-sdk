# BasicPreviewSecretFlow

main: kit: flow: BasicPreviewSecretFlow:
{
  entity: "preview_secret",
  kind: "basic",
  name: "BasicPreviewSecretFlow",
  step: [
    {
      i: {
        ref: "preview_secret_ref01"
      }

      m: {
        app_id: "app01",
        preview_id: "preview01"
      }

      o: "create"
    }

    {
      i: {
        ref: "preview_secret_ref01",
        suffix: "_rm0"
      }

      m: {
        app_id: "app01",
        id: "preview_secret01",
        preview_id: "preview01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicPreviewSecretFlow"
}