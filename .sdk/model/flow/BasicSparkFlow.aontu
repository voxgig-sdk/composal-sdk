# BasicSparkFlow

main: kit: flow: BasicSparkFlow:
{
  entity: "spark",
  kind: "basic",
  name: "BasicSparkFlow",
  step: [
    {
      i: {
        ref: "spark_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "spark_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSparkFlow"
}