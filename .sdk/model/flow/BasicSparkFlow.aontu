# BasicSparkFlow

main: kit: flow: BasicSparkFlow:
{
  entity: "spark",
  kind: "basic",
  name: "BasicSparkFlow",
  step: [
    {
      i: {
        ref: "spark_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "spark_ref01",
        srcdatavar: "spark_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "spark01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-spark_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSparkFlow"
}