# BasicInvitationFlow

main: kit: flow: BasicInvitationFlow:
{
  entity: "invitation",
  kind: "basic",
  name: "BasicInvitationFlow",
  step: [
    {
      i: {
        ref: "invitation_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "invitation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "invitation_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "invitation01",
        organization_id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "invitation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInvitationFlow"
}