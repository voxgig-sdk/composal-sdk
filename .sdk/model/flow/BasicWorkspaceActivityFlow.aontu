# BasicWorkspaceActivityFlow

main: kit: flow: BasicWorkspaceActivityFlow:
{
  entity: "workspace_activity",
  kind: "basic",
  name: "BasicWorkspaceActivityFlow",
  step: [
    {
      i: {
        ref: "workspace_activity_ref01",
        srcdatavar: "workspace_activity_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "workspace_activity01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-workspace_activity_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWorkspaceActivityFlow"
}