# BasicPersistentAgentDetailFlow

main: kit: flow: BasicPersistentAgentDetailFlow:
{
  entity: "persistent_agent_detail",
  kind: "basic",
  name: "BasicPersistentAgentDetailFlow",
  step: [
    {
      i: {
        ref: "persistent_agent_detail_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "persistent_agent_detail_ref01",
        srcdatavar: "persistent_agent_detail_ref01_data",
        suffix: "_up0",
        textfield: "attention"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-persistent_agent_detail_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "persistent_agent_detail_ref01",
        srcdatavar: "persistent_agent_detail_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "persistent_agent_detail01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-persistent_agent_detail_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "persistent_agent_detail_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "persistent_agent_detail01",
        organization_id: "organization01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicPersistentAgentDetailFlow"
}