# BasicProjectFindingFlow

main: kit: flow: BasicProjectFindingFlow:
{
  entity: "project_finding",
  kind: "basic",
  name: "BasicProjectFindingFlow",
  step: [
    {
      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_finding_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectFindingFlow"
}