# BasicAgentSessionCheckpointFlow

main: kit: flow: BasicAgentSessionCheckpointFlow:
{
  entity: "agent_session_checkpoint",
  kind: "basic",
  name: "BasicAgentSessionCheckpointFlow",
  step: [
    {
      i: {
        ref: "agent_session_checkpoint_ref01"
      }

      m: {
        agent_session_id: "agent_session01",
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "create"
    }

    {
      i: {
        ref: "agent_session_checkpoint_ref01",
        srcdatavar: "agent_session_checkpoint_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent_session_checkpoint01",
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_session_checkpoint_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentSessionCheckpointFlow"
}