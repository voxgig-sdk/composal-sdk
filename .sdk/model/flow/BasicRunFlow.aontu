# BasicRunFlow

main: kit: flow: BasicRunFlow:
{
  entity: "run",
  kind: "basic",
  name: "BasicRunFlow",
  step: [
    {
      i: {
        ref: "run_ref01"
      }

      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "run_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "run_ref01",
        srcdatavar: "run_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "run01",
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-run_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRunFlow"
}