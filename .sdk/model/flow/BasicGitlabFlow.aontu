# BasicGitlabFlow

main: kit: flow: BasicGitlabFlow:
{
  entity: "gitlab",
  kind: "basic",
  name: "BasicGitlabFlow",
  step: [
    {
      i: {
        ref: "gitlab_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "gitlab_ref01",
        srcdatavar: "gitlab_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "gitlab01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-gitlab_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGitlabFlow"
}