# BasicVerifyBrowserSessionFlow

main: kit: flow: BasicVerifyBrowserSessionFlow:
{
  entity: "verify_browser_session",
  kind: "basic",
  name: "BasicVerifyBrowserSessionFlow",
  step: [
    {
      i: {
        ref: "verify_browser_session_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "verify_browser_session_ref01",
        srcdatavar: "verify_browser_session_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "verify_browser_session01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-verify_browser_session_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "verify_browser_session_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "verify_browser_session01",
        organization_id: "organization01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicVerifyBrowserSessionFlow"
}