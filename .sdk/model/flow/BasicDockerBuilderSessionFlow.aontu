# BasicDockerBuilderSessionFlow

main: kit: flow: BasicDockerBuilderSessionFlow:
{
  entity: "docker_builder_session",
  kind: "basic",
  name: "BasicDockerBuilderSessionFlow",
  step: [
    {
      i: {
        ref: "docker_builder_session_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "docker_builder_session_ref01",
        srcdatavar: "docker_builder_session_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "docker_builder_session01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-docker_builder_session_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "docker_builder_session_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "docker_builder_session01",
        organization_id: "organization01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicDockerBuilderSessionFlow"
}