# BasicAppDeploymentDashboardFlow

main: kit: flow: BasicAppDeploymentDashboardFlow:
{
  entity: "app_deployment_dashboard",
  kind: "basic",
  name: "BasicAppDeploymentDashboardFlow",
  step: [
    {
      i: {
        ref: "app_deployment_dashboard_ref01",
        srcdatavar: "app_deployment_dashboard_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "app_deployment_dashboard01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-app_deployment_dashboard_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAppDeploymentDashboardFlow"
}