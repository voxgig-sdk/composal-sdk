# BasicSpaceMetricSeryFlow

main: kit: flow: BasicSpaceMetricSeryFlow:
{
  entity: "space_metric_sery",
  kind: "basic",
  name: "BasicSpaceMetricSeryFlow",
  step: [
    {
      i: {
        ref: "space_metric_sery_ref01"
      }

      m: {
        space_id: "space01"
      }

      o: "create"
    }

    {
      i: {
        ref: "space_metric_sery_ref01",
        srcdatavar: "space_metric_sery_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "space_metric_sery01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-space_metric_sery_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSpaceMetricSeryFlow"
}