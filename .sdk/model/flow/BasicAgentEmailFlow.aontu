# BasicAgentEmailFlow

main: kit: flow: BasicAgentEmailFlow:
{
  entity: "agent_email",
  kind: "basic",
  name: "BasicAgentEmailFlow",
  step: [
    {
      i: {
        ref: "agent_email_ref01",
        srcdatavar: "agent_email_ref01_data",
        suffix: "_dt0"
      }

      m: {
        agent_id: "agent01",
        id: "agent_email01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_email_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentEmailFlow"
}