# BasicDockerBuilderSettingFlow

main: kit: flow: BasicDockerBuilderSettingFlow:
{
  entity: "docker_builder_setting",
  kind: "basic",
  name: "BasicDockerBuilderSettingFlow",
  step: [
    {
      i: {
        ref: "docker_builder_setting_ref01",
        srcdatavar: "docker_builder_setting_ref01_data",
        suffix: "_up0",
        textfield: "region"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-docker_builder_setting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "docker_builder_setting_ref01",
        srcdatavar: "docker_builder_setting_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "docker_builder_setting01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-docker_builder_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDockerBuilderSettingFlow"
}