# BasicAccountEmailFlow

main: kit: flow: BasicAccountEmailFlow:
{
  entity: "account_email",
  kind: "basic",
  name: "BasicAccountEmailFlow",
  step: [
    {
      i: {
        ref: "account_email_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "account_email_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "account_email_ref01",
        srcdatavar: "account_email_ref01_data",
        suffix: "_up0",
        textfield: "email"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_email_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "account_email_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "account_email01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "account_email_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccountEmailFlow"
}