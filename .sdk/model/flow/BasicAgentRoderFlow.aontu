# BasicAgentRoderFlow

main: kit: flow: BasicAgentRoderFlow:
{
  entity: "agent_roder",
  kind: "basic",
  name: "BasicAgentRoderFlow",
  step: [
    {
      i: {
        ref: "agent_roder_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "agent_roder_ref01",
        srcdatavar: "agent_roder_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_roder_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentRoderFlow"
}