# BasicGithubConnectionFlow

main: kit: flow: BasicGithubConnectionFlow:
{
  entity: "github_connection",
  kind: "basic",
  name: "BasicGithubConnectionFlow",
  step: [
    {
      i: {
        ref: "github_connection_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "github_connection_ref01",
        srcdatavar: "github_connection_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "github_connection01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-github_connection_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGithubConnectionFlow"
}