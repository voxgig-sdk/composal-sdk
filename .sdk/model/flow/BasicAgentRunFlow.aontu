# BasicAgentRunFlow

main: kit: flow: BasicAgentRunFlow:
{
  entity: "agent_run",
  kind: "basic",
  name: "BasicAgentRunFlow",
  step: [
    {
      i: {
        ref: "agent_run_ref01",
        srcdatavar: "agent_run_ref01_data",
        suffix: "_dt0"
      }

      m: {
        agent_id: "agent01",
        id: "agent_run01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_run_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentRunFlow"
}