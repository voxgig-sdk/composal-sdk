# BasicRepoStatFlow

main: kit: flow: BasicRepoStatFlow:
{
  entity: "repo_stat",
  kind: "basic",
  name: "BasicRepoStatFlow",
  step: [
    {
      i: {
        ref: "repo_stat_ref01"
      }

      m: {
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "create"
    }

    {
      i: {
        ref: "repo_stat_ref01",
        srcdatavar: "repo_stat_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "repo_stat01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repo_stat_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepoStatFlow"
}