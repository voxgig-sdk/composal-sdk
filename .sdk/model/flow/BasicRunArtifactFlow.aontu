# BasicRunArtifactFlow

main: kit: flow: BasicRunArtifactFlow:
{
  entity: "run_artifact",
  kind: "basic",
  name: "BasicRunArtifactFlow",
  step: [
    {
      i: {
        ref: "run_artifact_ref01"
      }

      m: {
        pipeline_id: "pipeline01",
        run_id: "run01"
      }

      o: "create"
    }

    {
      i: {
        ref: "run_artifact_ref01",
        srcdatavar: "run_artifact_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "run_artifact01",
        pipeline_id: "pipeline01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-run_artifact_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRunArtifactFlow"
}