# BasicEnvironmentSecretBindingFlow

main: kit: flow: BasicEnvironmentSecretBindingFlow:
{
  entity: "environment_secret_binding",
  kind: "basic",
  name: "BasicEnvironmentSecretBindingFlow",
  step: [
    {
      i: {
        ref: "environment_secret_binding_ref01"
      }

      m: {
        app_id: "app01",
        environment_id: "environment01"
      }

      o: "create"
    }

    {
      m: {
        app_id: "app01",
        environment_id: "environment01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "environment_secret_binding_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "environment_secret_binding_ref01",
        suffix: "_rm0"
      }

      m: {
        app_id: "app01",
        environment_id: "environment01",
        id: "environment_secret_binding01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        app_id: "app01",
        environment_id: "environment01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "environment_secret_binding_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEnvironmentSecretBindingFlow"
}