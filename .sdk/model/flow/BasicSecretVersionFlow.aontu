# BasicSecretVersionFlow

main: kit: flow: BasicSecretVersionFlow:
{
  entity: "secret_version",
  kind: "basic",
  name: "BasicSecretVersionFlow",
  step: [
    {
      i: {
        ref: "secret_version_ref01"
      }

      m: {
        organization_id: "organization01",
        secret_id: "secret01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01",
        secret_id: "secret01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "secret_version_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01",
        secret_id: "secret01"
      }

      i: {
        ref: "secret_version_ref01",
        srcdatavar: "secret_version_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_version_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "secret_version_ref01",
        srcdatavar: "secret_version_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "secret_version01",
        organization_id: "organization01",
        secret_id: "secret01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_version_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "secret_version_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "secret_version01",
        organization_id: "organization01",
        secret_id: "secret01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01",
        secret_id: "secret01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "secret_version_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretVersionFlow"
}