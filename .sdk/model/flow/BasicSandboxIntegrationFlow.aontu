# BasicSandboxIntegrationFlow

main: kit: flow: BasicSandboxIntegrationFlow:
{
  entity: "sandbox_integration",
  kind: "basic",
  name: "BasicSandboxIntegrationFlow",
  step: [
    {
      i: {
        ref: "sandbox_integration_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "sandbox_integration_ref01",
        srcdatavar: "sandbox_integration_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-sandbox_integration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "sandbox_integration_ref01",
        srcdatavar: "sandbox_integration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "sandbox_integration01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-sandbox_integration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSandboxIntegrationFlow"
}