# BasicVerifyEnvironmentDetailFlow

main: kit: flow: BasicVerifyEnvironmentDetailFlow:
{
  entity: "verify_environment_detail",
  kind: "basic",
  name: "BasicVerifyEnvironmentDetailFlow",
  step: [
    {
      i: {
        ref: "verify_environment_detail_ref01"
      }

      m: {
        environment_id: "environment01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "verify_environment_detail_ref01",
        srcdatavar: "verify_environment_detail_ref01_data",
        suffix: "_up0",
        textfield: "managed_google_email"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-verify_environment_detail_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "verify_environment_detail_ref01",
        srcdatavar: "verify_environment_detail_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "verify_environment_detail01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-verify_environment_detail_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "verify_environment_detail_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "verify_environment_detail01",
        organization_id: "organization01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicVerifyEnvironmentDetailFlow"
}