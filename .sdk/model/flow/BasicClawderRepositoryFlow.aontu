# BasicClawderRepositoryFlow

main: kit: flow: BasicClawderRepositoryFlow:
{
  entity: "clawder_repository",
  kind: "basic",
  name: "BasicClawderRepositoryFlow",
  step: [
    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "clawder_repository_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "clawder_repository_ref01",
        srcdatavar: "clawder_repository_ref01_data",
        suffix: "_up0",
        textfield: "repository_choices_error"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-clawder_repository_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicClawderRepositoryFlow"
}