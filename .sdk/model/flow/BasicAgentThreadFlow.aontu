# BasicAgentThreadFlow

main: kit: flow: BasicAgentThreadFlow:
{
  entity: "agent_thread",
  kind: "basic",
  name: "BasicAgentThreadFlow",
  step: [
    {
      i: {
        ref: "agent_thread_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "agent_thread_ref01",
        srcdatavar: "agent_thread_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_thread_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentThreadFlow"
}