# BasicBrowserSessionEventFlow

main: kit: flow: BasicBrowserSessionEventFlow:
{
  entity: "browser_session_event",
  kind: "basic",
  name: "BasicBrowserSessionEventFlow",
  step: [
    {
      m: {
        browser_session_id: "browser_session01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "browser_session_event_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBrowserSessionEventFlow"
}