# BasicHostingFlow

main: kit: flow: BasicHostingFlow:
{
  entity: "hosting",
  kind: "basic",
  name: "BasicHostingFlow",
  step: [
    {
      i: {
        ref: "hosting_ref01"
      }

      m: {
        app_id: "app01",
        cdn_id: "cdn01",
        domain_id: "domain01",
        environment_id: "environment01",
        preview_id: "preview01",
        preview_profile_id: "preview_profile01",
        service_id: "service01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "hosting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "hosting_ref01",
        srcdatavar: "hosting_ref01_data",
        suffix: "_up0",
        textfield: "access"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-hosting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "hosting_ref01",
        srcdatavar: "hosting_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-hosting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "hosting_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "hosting01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "hosting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicHostingFlow"
}