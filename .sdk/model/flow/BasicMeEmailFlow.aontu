# BasicMeEmailFlow

main: kit: flow: BasicMeEmailFlow:
{
  entity: "me_email",
  kind: "basic",
  name: "BasicMeEmailFlow",
  step: [
    {
      i: {
        ref: "me_email_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "me_email_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "me_email_ref01",
        srcdatavar: "me_email_ref01_data",
        suffix: "_up0",
        textfield: "email"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-me_email_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "me_email_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "me_email01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "me_email_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMeEmailFlow"
}