# BasicPullRequestSettingFlow

main: kit: flow: BasicPullRequestSettingFlow:
{
  entity: "pull_request_setting",
  kind: "basic",
  name: "BasicPullRequestSettingFlow",
  step: [
    {
      i: {
        ref: "pull_request_setting_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "pull_request_setting_ref01",
        srcdatavar: "pull_request_setting_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pull_request_setting01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pull_request_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPullRequestSettingFlow"
}