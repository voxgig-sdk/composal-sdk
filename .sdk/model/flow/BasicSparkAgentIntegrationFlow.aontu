# BasicSparkAgentIntegrationFlow

main: kit: flow: BasicSparkAgentIntegrationFlow:
{
  entity: "spark_agent_integration",
  kind: "basic",
  name: "BasicSparkAgentIntegrationFlow",
  step: [
    {
      i: {
        ref: "spark_agent_integration_ref01"
      }

      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "spark_agent_integration_ref01",
        srcdatavar: "spark_agent_integration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "spark_agent_integration01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-spark_agent_integration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSparkAgentIntegrationFlow"
}