# BasicProjectMessagingConversationFlow

main: kit: flow: BasicProjectMessagingConversationFlow:
{
  entity: "project_messaging_conversation",
  kind: "basic",
  name: "BasicProjectMessagingConversationFlow",
  step: [
    {
      i: {
        ref: "project_messaging_conversation_ref01"
      }

      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "create"
    }

    {
      d: {
        organization_id: "organization01",
        project_id: "project01"
      }

      i: {
        ref: "project_messaging_conversation_ref01",
        srcdatavar: "project_messaging_conversation_ref01_data",
        suffix: "_up0",
        textfield: "assistant_number"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_messaging_conversation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "project_messaging_conversation_ref01",
        srcdatavar: "project_messaging_conversation_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "project_messaging_conversation01",
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_messaging_conversation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectMessagingConversationFlow"
}