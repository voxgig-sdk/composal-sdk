# BasicSiteAccessKeyFlow

main: kit: flow: BasicSiteAccessKeyFlow:
{
  entity: "site_access_key",
  kind: "basic",
  name: "BasicSiteAccessKeyFlow",
  step: [
    {
      i: {
        ref: "site_access_key_ref01"
      }

      m: {
        organization_id: "organization01",
        site_id: "site01"
      }

      o: "create"
    }

    {
      i: {
        ref: "site_access_key_ref01",
        srcdatavar: "site_access_key_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "site_access_key01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-site_access_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "site_access_key_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "site_access_key01",
        organization_id: "organization01",
        site_id: "site01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicSiteAccessKeyFlow"
}