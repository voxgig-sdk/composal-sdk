# BasicRepositoryAccessFlow

main: kit: flow: BasicRepositoryAccessFlow:
{
  entity: "repository_access",
  kind: "basic",
  name: "BasicRepositoryAccessFlow",
  step: [
    {
      i: {
        ref: "repository_access_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "repository_access_ref01",
        srcdatavar: "repository_access_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repository_access_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepositoryAccessFlow"
}