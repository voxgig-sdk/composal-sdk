# BasicAppRunFlow

main: kit: flow: BasicAppRunFlow:
{
  entity: "app_run",
  kind: "basic",
  name: "BasicAppRunFlow",
  step: [
    {
      i: {
        ref: "app_run_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "app_run_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "app_run_ref01",
        srcdatavar: "app_run_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "app_run01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-app_run_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAppRunFlow"
}