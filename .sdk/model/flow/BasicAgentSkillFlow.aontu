# BasicAgentSkillFlow

main: kit: flow: BasicAgentSkillFlow:
{
  entity: "agent_skill",
  kind: "basic",
  name: "BasicAgentSkillFlow",
  step: [
    {
      i: {
        ref: "agent_skill_ref01"
      }

      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_skill_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentSkillFlow"
}