# BasicProductMapFlow

main: kit: flow: BasicProductMapFlow:
{
  entity: "product_map",
  kind: "basic",
  name: "BasicProductMapFlow",
  step: [
    {
      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "product_map_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProductMapFlow"
}