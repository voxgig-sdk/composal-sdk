# BasicProjectCredentialInboxFlow

main: kit: flow: BasicProjectCredentialInboxFlow:
{
  entity: "project_credential_inbox",
  kind: "basic",
  name: "BasicProjectCredentialInboxFlow",
  step: [
    {
      m: {
        credential_id: "credential01",
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_credential_inbox_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectCredentialInboxFlow"
}