# BasicSparkCreditFlow

main: kit: flow: BasicSparkCreditFlow:
{
  entity: "spark_credit",
  kind: "basic",
  name: "BasicSparkCreditFlow",
  step: [
    {
      i: {
        ref: "spark_credit_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "spark_credit_ref01",
        srcdatavar: "spark_credit_ref01_data",
        suffix: "_up0",
        textfield: "available_usd"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-spark_credit_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "spark_credit_ref01",
        srcdatavar: "spark_credit_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "spark_credit01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-spark_credit_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSparkCreditFlow"
}