# BasicFindingFlow

main: kit: flow: BasicFindingFlow:
{
  entity: "finding",
  kind: "basic",
  name: "BasicFindingFlow",
  step: [
    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "finding_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "finding_ref01",
        srcdatavar: "finding_ref01_data",
        suffix: "_up0",
        textfield: "confidence"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-finding_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "finding_ref01",
        srcdatavar: "finding_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "finding01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-finding_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFindingFlow"
}