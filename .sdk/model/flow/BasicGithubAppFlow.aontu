  name: "BasicGithubAppFlow",
  step: [
    {
      i: {
        ref: "github_app_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "github_app_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGithubAppFlow"
}