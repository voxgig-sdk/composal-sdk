# BasicHostingAppDomainFlow

main: kit: flow: BasicHostingAppDomainFlow:
{
  entity: "hosting_app_domain",
  kind: "basic",
  name: "BasicHostingAppDomainFlow",
  step: [
    {
      i: {
        ref: "hosting_app_domain_ref01"
      }

      m: {
        app_id: "app01"
      }

      o: "create"
    }

    {
      d: {
        app_id: "app01"
      }

      i: {
        ref: "hosting_app_domain_ref01",
        srcdatavar: "hosting_app_domain_ref01_data",
        suffix: "_up0",
        textfield: "app_environment_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-hosting_app_domain_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "hosting_app_domain_ref01",
        srcdatavar: "hosting_app_domain_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "hosting_app_domain01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-hosting_app_domain_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "hosting_app_domain_ref01",
        suffix: "_rm0"
      }

      m: {
        app_id: "app01",
        id: "hosting_app_domain01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicHostingAppDomainFlow"
}