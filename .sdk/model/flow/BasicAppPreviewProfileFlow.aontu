# BasicAppPreviewProfileFlow

main: kit: flow: BasicAppPreviewProfileFlow:
{
  entity: "app_preview_profile",
  kind: "basic",
  name: "BasicAppPreviewProfileFlow",
  step: [
    {
      i: {
        ref: "app_preview_profile_ref01"
      }

      m: {
        app_id: "app01"
      }

      o: "create"
    }

    {
      d: {
        app_id: "app01"
      }

      i: {
        ref: "app_preview_profile_ref01",
        srcdatavar: "app_preview_profile_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-app_preview_profile_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "app_preview_profile_ref01",
        srcdatavar: "app_preview_profile_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "app_preview_profile01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-app_preview_profile_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "app_preview_profile_ref01",
        suffix: "_rm0"
      }

      m: {
        app_id: "app01",
        id: "app_preview_profile01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicAppPreviewProfileFlow"
}