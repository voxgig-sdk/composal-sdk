# BasicAgentInteractionFlow

main: kit: flow: BasicAgentInteractionFlow:
{
  entity: "agent_interaction",
  kind: "basic",
  name: "BasicAgentInteractionFlow",
  step: [
    {
      i: {
        ref: "agent_interaction_ref01"
      }

      m: {
        agent_id: "agent01",
        organization_id: "organization01",
        request_id: "request01"
      }

      o: "create"
    }

    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_interaction_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_interaction_ref01",
        srcdatavar: "agent_interaction_ref01_data",
        suffix: "_dt0"
      }

      m: {
        agent_id: "agent01",
        id: "agent_interaction01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_interaction_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentInteractionFlow"
}