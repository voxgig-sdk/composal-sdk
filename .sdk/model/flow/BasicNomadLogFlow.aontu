# BasicNomadLogFlow

main: kit: flow: BasicNomadLogFlow:
{
  entity: "nomad_log",
  kind: "basic",
  name: "BasicNomadLogFlow",
  step: [
    {
      i: {
        ref: "nomad_log_ref01",
        srcdatavar: "nomad_log_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "nomad_log01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-nomad_log_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNomadLogFlow"
}