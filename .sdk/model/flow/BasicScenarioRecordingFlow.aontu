# BasicScenarioRecordingFlow

main: kit: flow: BasicScenarioRecordingFlow:
{
  entity: "scenario_recording",
  kind: "basic",
  name: "BasicScenarioRecordingFlow",
  step: [
    {
      i: {
        ref: "scenario_recording_ref01"
      }

      m: {
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "create"
    }

    {
      i: {
        ref: "scenario_recording_ref01",
        srcdatavar: "scenario_recording_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "scenario_recording01",
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-scenario_recording_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "scenario_recording_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "scenario_recording01",
        organization_id: "organization01",
        project_id: "project01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicScenarioRecordingFlow"
}