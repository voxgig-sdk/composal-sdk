# BasicExecutionReleaseFlow

main: kit: flow: BasicExecutionReleaseFlow:
{
  entity: "execution_release",
  kind: "basic",
  name: "BasicExecutionReleaseFlow",
  step: [
    {
      i: {
        ref: "execution_release_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "execution_release_ref01",
        srcdatavar: "execution_release_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-execution_release_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicExecutionReleaseFlow"
}