# BasicRepoAccessTokenFlow

main: kit: flow: BasicRepoAccessTokenFlow:
{
  entity: "repo_access_token",
  kind: "basic",
  name: "BasicRepoAccessTokenFlow",
  step: [
    {
      i: {
        ref: "repo_access_token_ref01"
      }

      m: {
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "repo_access_token_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "repo_access_token_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "repo_access_token01",
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "repo_access_token_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepoAccessTokenFlow"
}