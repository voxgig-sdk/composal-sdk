# BasicPagesSessionFlow

main: kit: flow: BasicPagesSessionFlow:
{
  entity: "pages_session",
  kind: "basic",
  name: "BasicPagesSessionFlow",
  step: [
    {
      i: {
        ref: "pages_session_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "pages_session_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pages_session_ref01",
        srcdatavar: "pages_session_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pages_session01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pages_session_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPagesSessionFlow"
}