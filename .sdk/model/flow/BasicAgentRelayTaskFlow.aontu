# BasicAgentRelayTaskFlow

main: kit: flow: BasicAgentRelayTaskFlow:
{
  entity: "agent_relay_task",
  kind: "basic",
  name: "BasicAgentRelayTaskFlow",
  step: [
    {
      i: {
        ref: "agent_relay_task_ref01",
        srcdatavar: "agent_relay_task_ref01_data",
        suffix: "_dt0"
      }

      m: {
        agent_id: "agent01",
        id: "agent_relay_task01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_relay_task_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentRelayTaskFlow"
}