# BasicOrganizationServiceAccountFlow

main: kit: flow: BasicOrganizationServiceAccountFlow:
{
  entity: "organization_service_account",
  kind: "basic",
  name: "BasicOrganizationServiceAccountFlow",
  step: [
    {
      i: {
        ref: "organization_service_account_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "organization_service_account_ref01",
        srcdatavar: "organization_service_account_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-organization_service_account_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "organization_service_account_ref01",
        srcdatavar: "organization_service_account_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "organization_service_account01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-organization_service_account_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "organization_service_account_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "organization_service_account01",
        organization_id: "organization01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicOrganizationServiceAccountFlow"
}