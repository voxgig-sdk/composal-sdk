# BasicReleaseRolloutFlow

main: kit: flow: BasicReleaseRolloutFlow:
{
  entity: "release_rollout",
  kind: "basic",
  name: "BasicReleaseRolloutFlow",
  step: [
    {
      i: {
        ref: "release_rollout_ref01"
      }

      m: {
        release_id: "release01"
      }

      o: "create"
    }

    {
      i: {
        ref: "release_rollout_ref01",
        srcdatavar: "release_rollout_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "release_rollout01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-release_rollout_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReleaseRolloutFlow"
}