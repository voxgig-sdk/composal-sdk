# BasicJobStepFlow

main: kit: flow: BasicJobStepFlow:
{
  entity: "job_step",
  kind: "basic",
  name: "BasicJobStepFlow",
  step: [
    {
      i: {
        ref: "job_step_ref01"
      }

      m: {
        job_id: "job01",
        pipeline_id: "pipeline01",
        run_id: "run01"
      }

      o: "create"
    }

    {
      d: {
        job_id: "job01",
        pipeline_id: "pipeline01",
        run_id: "run01"
      }

      i: {
        ref: "job_step_ref01",
        srcdatavar: "job_step_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-job_step_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "job_step_ref01",
        srcdatavar: "job_step_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "job_step01",
        pipeline_id: "pipeline01",
        run_id: "run01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-job_step_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicJobStepFlow"
}