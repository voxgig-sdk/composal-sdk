# BasicAgentEventFlow

main: kit: flow: BasicAgentEventFlow:
{
  entity: "agent_event",
  kind: "basic",
  name: "BasicAgentEventFlow",
  step: [
    {
      i: {
        ref: "agent_event_ref01",
        srcdatavar: "agent_event_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent_event01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_event_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentEventFlow"
}