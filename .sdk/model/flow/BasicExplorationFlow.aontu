# BasicExplorationFlow

main: kit: flow: BasicExplorationFlow:
{
  entity: "exploration",
  kind: "basic",
  name: "BasicExplorationFlow",
  step: [
    {
      i: {
        ref: "exploration_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "exploration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "exploration_ref01",
        srcdatavar: "exploration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "exploration01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-exploration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicExplorationFlow"
}