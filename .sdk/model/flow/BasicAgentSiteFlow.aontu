# BasicAgentSiteFlow

main: kit: flow: BasicAgentSiteFlow:
{
  entity: "agent_site",
  kind: "basic",
  name: "BasicAgentSiteFlow",
  step: [
    {
      i: {
        ref: "agent_site_ref01"
      }

      m: {
        id: "id01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_site_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_site_ref01",
        srcdatavar: "agent_site_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent_site01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_site_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentSiteFlow"
}