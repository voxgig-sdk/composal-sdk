# BasicAgentIntegrationFlow

main: kit: flow: BasicAgentIntegrationFlow:
{
  entity: "agent_integration",
  kind: "basic",
  name: "BasicAgentIntegrationFlow",
  step: [
    {
      i: {
        ref: "agent_integration_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_integration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_integration_ref01",
        srcdatavar: "agent_integration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent_integration01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_integration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_integration_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "agent_integration01",
        organization_id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "agent_integration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentIntegrationFlow"
}