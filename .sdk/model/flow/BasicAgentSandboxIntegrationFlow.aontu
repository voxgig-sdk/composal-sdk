# BasicAgentSandboxIntegrationFlow

main: kit: flow: BasicAgentSandboxIntegrationFlow:
{
  entity: "agent_sandbox_integration",
  kind: "basic",
  name: "BasicAgentSandboxIntegrationFlow",
  step: [
    {
      i: {
        ref: "agent_sandbox_integration_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_sandbox_integration_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "agent_sandbox_integration_ref01",
        srcdatavar: "agent_sandbox_integration_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_sandbox_integration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentSandboxIntegrationFlow"
}