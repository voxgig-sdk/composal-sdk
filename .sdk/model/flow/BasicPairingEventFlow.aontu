# BasicPairingEventFlow

main: kit: flow: BasicPairingEventFlow:
{
  entity: "pairing_event",
  kind: "basic",
  name: "BasicPairingEventFlow",
  step: [
    {
      i: {
        ref: "pairing_event_ref01",
        srcdatavar: "pairing_event_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pairing_event01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pairing_event_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPairingEventFlow"
}