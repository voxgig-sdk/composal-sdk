# BasicAgentResourceFlow

main: kit: flow: BasicAgentResourceFlow:
{
  entity: "agent_resource",
  kind: "basic",
  name: "BasicAgentResourceFlow",
  step: [
    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_resource_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentResourceFlow"
}