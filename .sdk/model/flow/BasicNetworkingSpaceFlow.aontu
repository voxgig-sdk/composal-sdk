# BasicNetworkingSpaceFlow

main: kit: flow: BasicNetworkingSpaceFlow:
{
  entity: "networking_space",
  kind: "basic",
  name: "BasicNetworkingSpaceFlow",
  step: [
    {
      i: {
        ref: "networking_space_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "networking_space_ref01",
        srcdatavar: "networking_space_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-networking_space_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "networking_space_ref01",
        srcdatavar: "networking_space_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-networking_space_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "networking_space_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "networking_space01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicNetworkingSpaceFlow"
}