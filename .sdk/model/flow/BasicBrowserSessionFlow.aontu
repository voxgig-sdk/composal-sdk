# BasicBrowserSessionFlow

main: kit: flow: BasicBrowserSessionFlow:
{
  entity: "browser_session",
  kind: "basic",
  name: "BasicBrowserSessionFlow",
  step: [
    {
      i: {
        ref: "browser_session_ref01"
      }

      m: {
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      i: {
        ref: "browser_session_ref01",
        srcdatavar: "browser_session_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "browser_session01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-browser_session_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "browser_session_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "browser_session01",
        organization_id: "organization01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicBrowserSessionFlow"
}