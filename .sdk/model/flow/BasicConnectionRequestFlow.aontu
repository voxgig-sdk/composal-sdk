# BasicConnectionRequestFlow

main: kit: flow: BasicConnectionRequestFlow:
{
  entity: "connection_request",
  kind: "basic",
  name: "BasicConnectionRequestFlow",
  step: [
    {
      i: {
        ref: "connection_request_ref01",
        srcdatavar: "connection_request_ref01_data",
        suffix: "_dt0"
      }

      m: {
        agent_id: "agent01",
        id: "connection_request01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-connection_request_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicConnectionRequestFlow"
}