  step: [
    {
      i: {
        ref: "spark_agent_thread_ref01"
      }

      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "spark_agent_thread_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSparkAgentThreadFlow"
}