# BasicPagesRegistryFlow

main: kit: flow: BasicPagesRegistryFlow:
{
  entity: "pages_registry",
  kind: "basic",
  name: "BasicPagesRegistryFlow",
  step: [
    {
      i: {
        ref: "pages_registry_ref01",
        srcdatavar: "pages_registry_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pages_registry01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pages_registry_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPagesRegistryFlow"
}