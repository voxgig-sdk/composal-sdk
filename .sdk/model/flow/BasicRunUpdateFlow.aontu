# BasicRunUpdateFlow

main: kit: flow: BasicRunUpdateFlow:
{
  entity: "run_update",
  kind: "basic",
  name: "BasicRunUpdateFlow",
  step: [
    {
      i: {
        ref: "run_update_ref01",
        srcdatavar: "run_update_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "run_update01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-run_update_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRunUpdateFlow"
}