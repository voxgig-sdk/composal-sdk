  step: [
    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "clawder_agent_email_inbox_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicClawderAgentEmailInboxFlow"
}