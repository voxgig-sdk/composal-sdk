# BasicAgentAutomationFlow

main: kit: flow: BasicAgentAutomationFlow:
{
  entity: "agent_automation",
  kind: "basic",
  name: "BasicAgentAutomationFlow",
  step: [
    {
      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "agent_automation_ref01"
          }
        }
      ]
    }

    {
      d: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      i: {
        ref: "agent_automation_ref01",
        srcdatavar: "agent_automation_ref01_data",
        suffix: "_up0",
        textfield: "key"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_automation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_automation_ref01",
        srcdatavar: "agent_automation_ref01_data",
        suffix: "_dt0"
      }

      m: {
        agent_id: "agent01",
        id: "agent_automation01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_automation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentAutomationFlow"
}