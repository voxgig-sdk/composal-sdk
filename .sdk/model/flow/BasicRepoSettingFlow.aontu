# BasicRepoSettingFlow

main: kit: flow: BasicRepoSettingFlow:
{
  entity: "repo_setting",
  kind: "basic",
  name: "BasicRepoSettingFlow",
  step: [
    {
      m: {
        organization_id: "organization01",
        repo_id: "repo01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "repo_setting_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "repo_setting_ref01",
        srcdatavar: "repo_setting_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repo_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepoSettingFlow"
}