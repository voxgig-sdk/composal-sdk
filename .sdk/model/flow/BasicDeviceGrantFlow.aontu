        device_id: "device01",
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "device_grant_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDeviceGrantFlow"
