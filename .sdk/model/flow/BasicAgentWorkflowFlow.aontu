# BasicAgentWorkflowFlow

main: kit: flow: BasicAgentWorkflowFlow:
{
  entity: "agent_workflow",
  kind: "basic",
  name: "BasicAgentWorkflowFlow",
  step: [
    {
      i: {
        ref: "agent_workflow_ref01"
      }

      m: {
        agent_id: "agent01",
        organization_id: "organization01"
      }

      o: "create"
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "agent_workflow_ref01",
        srcdatavar: "agent_workflow_ref01_data",
        suffix: "_up0",
        textfield: "expected_digest"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_workflow_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_workflow_ref01",
        srcdatavar: "agent_workflow_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "agent_workflow01",
        organization_id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_workflow_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentWorkflowFlow"
}