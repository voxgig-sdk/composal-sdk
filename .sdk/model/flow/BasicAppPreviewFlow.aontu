# BasicAppPreviewFlow

main: kit: flow: BasicAppPreviewFlow:
{
  entity: "app_preview",
  kind: "basic",
  name: "BasicAppPreviewFlow",
  step: [
    {
      i: {
        ref: "app_preview_ref01"
      }

      m: {
        app_id: "app01"
      }

      o: "create"
    }

    {
      d: {
        app_id: "app01"
      }

      i: {
        ref: "app_preview_ref01",
        srcdatavar: "app_preview_ref01_data",
        suffix: "_up0",
        textfield: "access"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-app_preview_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "app_preview_ref01",
        srcdatavar: "app_preview_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "app_preview01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-app_preview_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "app_preview_ref01",
        suffix: "_rm0"
      }

      m: {
        app_id: "app01",
        id: "app_preview01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicAppPreviewFlow"
}